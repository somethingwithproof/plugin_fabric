#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "العقدة مرتبطة بجهاز بالفعل."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "لا يفحص المُستطلِع الرئيسي شبكة ربط العقدة، لذلك يتعذّر استطلاع جهازها."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "الجهاز غير موجود."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "يستطلع الجهازَ مُستطلِعٌ مختلف عن الذي يفحص شبكة الربط، لذا يتعذّر عليه قراءة ذاكرة الشبكة المؤقتة."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "جهاز «%s» من قالب الأجهزة %s، باسم المضيف %s، يستطلعه المُستطلِع %d، مع تعطيل فحوص التوافر وSNMP."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "استعلام البيانات %s عليه، ويسرد منافذ العقدة. لا ينشئ بمفرده أي رسم أو مصدر بيانات."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "أنشأته إضافة Fabric للعقدة %s. تأتي قيمه من ذاكرة الإضافة المؤقتة؛ اسم المضيف محجوز ولا يُتصل به مطلقًا."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "الاسم: استخدم من 1 إلى 64 حرفًا أو رقمًا أو مسافة أو نقطة أو شرطة أو شرطة سفلية، على أن يبدأ بحرف أو رقم."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "الواجهة الخلفية: اختر إحدى الواجهات المدرجة."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "المُستطلِع: اختر أحد المُستطلِعات المدرجة."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "المُستطلِع: لا يمكن فحص شبكة الربط إلا بالمُستطلِع الرئيسي حتى تُضاف إمكانية المُستطلِعات البعيدة."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "الفاصل بين الفحوص: أدخل عددًا صحيحًا من الثواني بين %d و%d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "المحوّل: أدخل اسم المحوّل المحلي كما يسميه النواة، مثل mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "منفذ المحوّل: أدخل رقم منفذ المحوّل المحلي من 1 إلى %d."

