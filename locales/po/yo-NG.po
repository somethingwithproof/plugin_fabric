#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: a kò tíì ṣàwárí rẹ̀. Àwọn ìṣàyẹ̀wò máa ń bẹ̀rẹ̀ láti nóòdù tí a so pọ̀ mọ́ ẹ̀rọ Cacti nìkan, nítorí náà ṣiṣẹ́ \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" lórí main poller lẹ́ẹ̀kan."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: kò sí nóòdù tí a so pọ̀ mọ́ ẹ̀rọ Cacti, nítorí náà kò sí ìṣàyẹ̀wò tó bẹ̀rẹ̀, a kò sì tún àkójọ náà ṣe. So nóòdù kan pọ̀ lórí ojú-ewé Alábòójútó Fabric, tàbí ṣiṣẹ́ \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" lórí main poller."

#: lib/HealthPage.php
