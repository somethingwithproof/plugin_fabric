msgstr "Kì í ṣe root ni ó ni àpò-ìwé ohun-èlò náà."

#: lib/ToolDirectory.php
msgid "The tool directory can be written by its group or by others."
msgstr "Ẹgbẹ́ rẹ̀ tàbí àwọn mìíràn lè kọ nǹkan sí àpò-ìwé ohun-èlò náà."

#: lib/ToolDirectory.php
