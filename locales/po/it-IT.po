#, php-format
msgid "The node mapping was not changed. %s"
msgstr "La mappatura del nodo non è stata modificata. %s"

#: fabric_admin.php
msgid "The node mapping was not changed."
msgstr "La mappatura del nodo non è stata modificata."

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "La mappatura del nodo è stata salvata."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "Nessun dispositivo creato. Consultare il registro di Cacti."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "Il dispositivo è stato creato e il nodo è stato mappato su di esso. Scegliere le porte da rappresentare graficamente nella pagina Nuovi grafici."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "Impossibile leggere l'inventario per l'esportazione."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "I modelli e il file di query dati di Fabric sono stati installati."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "I modelli di Fabric non sono stati installati. Consultare la tabella Oggetti Cacti e il registro di Cacti."

#: fabric_operator.php
msgid "Monitoring view"
msgstr "Vista monitoraggio"

#: fabric_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Impossibile leggere le osservazioni. Chiedere a un amministratore di controllare il registro del plugin."

#: include/operator.php
msgid "Inspect port validity, link width and speed, and the congestion view. Escalate identity conflicts and device relinking to an administrator; do not reset counters."
msgstr "Verificare la validità delle porte, l'ampiezza e la velocità del collegamento e la vista della congestione. Segnalare i conflitti di identità e il ricollegamento dei dispositivi a un amministratore; non azzerare i contatori."

