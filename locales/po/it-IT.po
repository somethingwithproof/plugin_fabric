#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "I modelli di Fabric non sono installati. Reinstallarli dalla pagina di integrità."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Il nodo è già mappato su un dispositivo."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "La fabric del nodo non viene scansionata dal poller principale, pertanto il suo dispositivo non può essere sottoposto a polling."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Il dispositivo non esiste."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Il dispositivo è sottoposto a polling da un poller diverso da quello che scansiona questa fabric, pertanto non può leggere la cache della fabric."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Un dispositivo \"%s\" dal modello di dispositivo %s, nome host %s, sottoposto a polling dal poller %d, con controlli di disponibilità e SNMP disattivati."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "La query dati %s su di esso, che elenca le porte del nodo. Non crea alcun grafico né alcuna origine dati autonomamente."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Creato dal plugin Fabric per il nodo %s. I relativi valori provengono dalla cache del plugin; il nome host è un nome riservato che non viene mai contattato."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nome: utilizzare da 1 a 64 lettere, cifre, spazi, punti, trattini o trattini bassi, iniziando con una lettera o una cifra."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Backend: scegliere uno dei backend elencati."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: scegliere uno dei poller elencati."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: solo il poller principale può scansionare una fabric finché non sarà aggiunto il supporto per i poller remoti."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Intervallo di scansione: inserire un numero intero di secondi da %d a %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adattatore: inserire il nome dell'adattatore locale come denominato dal kernel, ad esempio mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Porta adattatore: inserire il numero di porta dell'adattatore locale, da 1 a %d."

