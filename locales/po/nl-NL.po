#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabric %s: het bijbehorende gezondheidsrecord kon niet worden gelezen, dus de detectiestatus is onbekend. Raadpleeg het Cacti-logboek."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: deze is nog niet gedetecteerd. Scans starten alleen vanaf een knooppunt dat aan een Cacti-apparaat is gekoppeld, dus voer eenmaal \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" uit op de hoofdpoller."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: er is geen knooppunt gekoppeld aan een Cacti-apparaat, dus er start geen scan en de inventaris wordt niet vernieuwd. Koppel een knooppunt op de pagina Fabric-beheer, of voer \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" uit op de hoofdpoller."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabric %s: %d iblinkinfo-regels konden niet worden gelezen, hoogstwaarschijnlijk omdat een knooppuntbeschrijving de uitvoer van het hulpprogramma nabootst. Die knooppunten behouden hun laatste linkstatussen."

