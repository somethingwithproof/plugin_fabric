#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "قوالب Fabric غير مثبتة. أعد تثبيتها من صفحة الحالة الصحية."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "العقدة مربوطة بالفعل بجهاز."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "نسيج الشبكة الخاص بالعقدة لا يمسحه المجمّع الرئيسي، لذا تعذر تجميع بيانات جهازه."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "الجهاز غير موجود."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "يتم تجميع بيانات الجهاز بواسطة مجمّع مختلف عن المجمّع الذي يمسح نسيج الشبكة هذا، لذا تعذرت قراءة ذاكرة التخزين المؤقت لنسيج الشبكة."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "جهاز \"%s\" من قالب الجهاز %s، باسم المضيف %s، يتم تجميعه بواسطة المجمّع %d، مع إيقاف فحوصات التوافر وSNMP."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "استعلام البيانات %s عليه لعرض منافذ العقدة. لا ينشئ أي رسم بياني أو مصدر بيانات من تلقاء نفسه."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "تم إنشاؤه بواسطة إضافة Fabric للعقدة %s. تأتي قيمه من ذاكرة التخزين المؤقت للإضافة؛ واسم المضيف هو اسم محجوز لا يتم الاتصال به أبداً."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "الاسم: استخدم من 1 إلى 64 حرفاً أو رقماً أو مسافة أو نقطة أو شرطة أو شرطة سفلية، على أن يبدأ بحرف أو رقم."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "الواجهة الخلفية: اختر إحدى الواجهات الخلفية المدرجة."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "المجمّع: اختر أحد المجمّعات المدرجة."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "المجمّع: يمكن للمجمّع الرئيسي فقط مسح نسيج الشبكة حتى تتم إضافة دعم المجمّع البعيد."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "الفترة الفاصلة للمسح: أدخل عدداً صحيحاً من الثواني من %d إلى %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "المحول: أدخل اسم المحول المحلي كما تسميه النواة، مثل mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "منفذ المحول: أدخل رقم منفذ المحول المحلي، من 1 إلى %d."

