#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: the inventory is %s; the last successful discovery was %s."
msgstr "Sieć fabric %s: inwentarz ma stan %s; ostatnie pomyślne wykrywanie odbyło się %s."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "Sieć fabric %s: przypisano ją do pollera %d, ale tylko główny poller może skanować sieć fabric do czasu dodania obsługi zdalnych pollerów. Nie jest skanowana; przypisz ją do głównego pollera."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Sieć fabric %s: nie udało się odczytać rekordu stanu, więc stan jej wykrywania jest nieznany. Sprawdź dziennik Cacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Sieć fabric %s: nie została jeszcze wykryta. Skanowania rozpoczynają się tylko od węzła powiązanego z urządzeniem Cacti, więc uruchom raz polecenie \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" na głównym pollerze."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Sieć fabric %s: żaden węzeł nie jest powiązany z urządzeniem Cacti, więc żadne skanowanie się nie rozpoczyna i inwentarz nie jest odświeżany. Powiąż węzeł na stronie Administracja Fabric lub uruchom polecenie \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" na głównym pollerze."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Sieć fabric %s: nie udało się odczytać %d linii narzędzia iblinkinfo, najprawdopodobniej dlatego, że opis węzła imituje format wyjścia narzędzia. Te węzły zachowują ostatnie stany łączy."

