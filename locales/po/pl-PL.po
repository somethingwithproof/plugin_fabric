#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Szablony Fabric nie są zainstalowane. Zainstaluj je ponownie ze strony stanu."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Węzeł jest już powiązany z urządzeniem."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Sieć fabric tego węzła nie jest skanowana przez główny poller, więc jego urządzenie nie mogło być odpytywane."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Urządzenie nie istnieje."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Urządzenie jest odpytywane przez inny poller niż ten, który skanuje tę sieć fabric, więc nie mogło odczytać pamięci podręcznej sieci fabric."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Urządzenie \"%s\" z szablonu urządzenia %s, nazwa hosta %s, odpytywane przez poller %d, z wyłączonym sprawdzaniem dostępności i SNMP."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Zapytanie o dane %s na tym urządzeniu, wyświetlające listę portów węzła. Samo w sobie nie tworzy żadnych wykresów ani źródeł danych."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Utworzono przez wtyczkę Fabric dla węzła %s. Wartości pochodzą z pamięci podręcznej wtyczki; nazwa hosta jest nazwą zastrzeżoną, z którą nigdy nie jest nawiązywane połączenie."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nazwa: użyj od 1 do 64 liter, cyfr, spacji, kropek, myślników lub podkreśleń, zaczynając od litery lub cyfry."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Backend: wybierz jeden z wymienionych backendów."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: wybierz jeden z wymienionych pollerów."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: tylko główny poller może skanować sieć fabric do czasu dodania obsługi zdalnych pollerów."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Interwał skanowania: podaj całkowitą liczbę sekund od %d do %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adapter: podaj nazwę lokalnego adaptera zgodną z nazwą w jądrze systemu, na przykład mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Port adaptera: podaj numer portu lokalnego adaptera od 1 do %d."

