msgid "Fabric %s: the inventory is %s; the last successful discovery was %s."
msgstr "Fabric %s: inventeringen är %s; den senaste lyckade upptäckten var %s."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "Fabric %s: den är tilldelad poller %d, men endast huvudpollern kan svepa en fabric tills stöd för fjärrpollrar läggs till. Den sveps inte; tilldela den till huvudpollern."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabric %s: dess hälsopost kunde inte läsas, så dess upptäcktsstatus är okänd. Se Cacti-loggen."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: den har inte upptäckts. Svepningar startar endast från en nod som är mappad till en Cacti-enhet, så kör \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" på huvudpollern en gång."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: ingen nod är mappad till en Cacti-enhet, så ingen svepning startar och inventeringen uppdateras inte. Mappa en nod på sidan Fabric-administration, eller kör \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" på huvudpollern."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabric %s: %d iblinkinfo-rader kunde inte läsas, troligen eftersom en nodbeskrivning efterliknar verktygets utdata. Dessa noder behåller sina senaste länkstatusar."

