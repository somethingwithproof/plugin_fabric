msgid "The node mapping was not changed."
msgstr "Nodmappningen ändrades inte."

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "Nodmappningen sparades."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "Ingen enhet skapades. Se Cacti-loggen."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "Enheten skapades och noden mappades till den. Välj vilka portar som ska ritas som grafer på sidan Nya grafer."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "Inventeringen kunde inte läsas för export."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "Fabric-mallarna och datafrågefilen installerades."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "Fabric-mallarna installerades inte. Se tabellen Cacti-objekt och Cacti-loggen."

