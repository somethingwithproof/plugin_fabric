#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Fabric-mallarna är inte installerade. Installera om dem från hälsosidan."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Noden är redan mappad till en enhet."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Nodens fabric sveps inte av huvudpollern, så dess enhet kunde inte pollas."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Enheten finns inte."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Enheten pollas av en annan poller än den som sveper den här fabricen, så den kunde inte läsa fabric-cachen."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "En enhet \"%s\" från enhetsmallen %s, värdnamn %s, pollad av poller %d, med tillgänglighetskontroller och SNMP avstängda."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Datafrågan %s på den, som listar nodens portar. Den skapar ingen graf och ingen datakälla i sig."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Skapad av Fabric-insticksmodulen för noden %s. Dess värden kommer från insticksmodulens cache; värdnamnet är ett reserverat namn som aldrig kontaktas."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Namn: använd 1 till 64 bokstäver, siffror, mellanslag, punkter, bindestreck eller understreck, med början på en bokstav eller siffra."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Backend: välj en av de listade backenderna."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: välj en av de listade pollrarna."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: endast huvudpollern kan svepa en fabric tills stöd för fjärrpollrar läggs till."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Svepintervall: ange hela sekunder från %d till %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adapter: ange namnet på den lokala adaptern så som kärnan namnger den, till exempel mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Adapterport: ange portnumret för den lokala adaptern, från 1 till %d."

