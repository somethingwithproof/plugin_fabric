#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "Noden ändrades efter att sidan ritades upp, så inget gjordes. Granska den och försök igen."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Dina enhetsbehörigheter tillåter inte ändring av den här posten."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Namn: en annan fabric använder redan det här namnet."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Adapter: en annan fabric sveper redan den här adapterporten på den här pollern. En fabric per adapterport."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Fabricen kunde inte sparas."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "Fabricen sparades."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "En svepning av den här fabricen pågår, så inget togs bort. Försök igen när den är klar."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "Fabricen och dess inventering togs bort. Ingen Cacti-enhet ändrades och fabricen kontaktades inte."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Fabricen kunde inte tas bort."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "Nodidentiteten ändrades inte."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Nodidentiteten uppdaterades. Den sveps igen från och med nästa cykel."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Enhetsmappningen flyttades till den nya noden."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Förslaget kunde inte bekräftas. Noderna kan ha ändrats sedan det skapades."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Förslaget kunde inte avvisas."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "Förslaget avvisades."

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "Nodmappningen ändrades inte. %s"

