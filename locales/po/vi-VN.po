msgstr "Cài đặt fabric hoặc plugin chưa đầy đủ hoặc không hợp lệ"

#: lib/CommandError.php
msgid "The tool is missing or not executable in the configured directory"
msgstr "Công cụ bị thiếu hoặc không thể thực thi trong thư mục đã cấu hình"

#: lib/CommandError.php
msgid "The tool exceeded its time limit and was stopped"
msgstr "Công cụ đã vượt quá giới hạn thời gian và bị dừng"

#: lib/CommandError.php
msgid "The tool output exceeded the size limit and was discarded"
msgstr "Đầu ra của công cụ đã vượt quá giới hạn kích thước và bị loại bỏ"

#: lib/CommandError.php
