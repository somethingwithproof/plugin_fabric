#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Các mẫu Fabric chưa được cài đặt. Hãy cài đặt lại chúng từ trang tình trạng."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Nút đã được ánh xạ tới một thiết bị."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Fabric của nút không được poller chính quét, nên không thể thăm dò thiết bị của nút."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Thiết bị không tồn tại."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Thiết bị được thăm dò bởi một poller khác với poller quét fabric này, nên không thể đọc bộ nhớ đệm của fabric."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Một thiết bị \"%s\" từ mẫu thiết bị %s, tên máy chủ %s, được thăm dò bởi poller %d, với kiểm tra tính khả dụng và SNMP đều tắt."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Truy vấn dữ liệu %s trên thiết bị đó, liệt kê các cổng của nút. Tự nó không tạo biểu đồ hay nguồn dữ liệu nào."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Được tạo bởi plugin Fabric cho nút %s. Các giá trị của nó lấy từ bộ nhớ đệm của plugin; tên máy chủ là tên dành riêng và không bao giờ được kết nối tới."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Tên: sử dụng từ 1 đến 64 chữ cái, chữ số, khoảng trắng, dấu chấm, dấu gạch ngang hoặc dấu gạch dưới, bắt đầu bằng chữ cái hoặc chữ số."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Backend: chọn một trong các backend được liệt kê."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: chọn một trong các poller được liệt kê."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: chỉ poller chính mới có thể quét fabric cho đến khi tính năng hỗ trợ poller từ xa được bổ sung."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Chu kỳ quét: nhập số giây nguyên từ %d đến %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Bộ điều hợp: nhập tên bộ điều hợp cục bộ theo đúng tên trong kernel, ví dụ mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Cổng bộ điều hợp: nhập số cổng của bộ điều hợp cục bộ, từ 1 đến %d."

