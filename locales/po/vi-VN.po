#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "Nút đã thay đổi sau khi trang được hiển thị, nên không có thao tác nào được thực hiện. Hãy kiểm tra lại và thử lại."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Quyền thiết bị của bạn không cho phép thay đổi bản ghi này."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Tên: một fabric khác đã sử dụng tên này."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Bộ điều hợp: một fabric khác đã quét cổng bộ điều hợp này trên poller này. Mỗi cổng bộ điều hợp chỉ dùng cho một fabric."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Không thể lưu fabric."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "Đã lưu fabric."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Đang có tiến trình quét fabric này chạy, nên không có mục nào bị xóa. Hãy thử lại sau khi hoàn tất."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "Đã xóa fabric và danh mục của nó. Không có thiết bị Cacti nào bị thay đổi và không có kết nối nào được gửi tới fabric."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Không thể xóa fabric."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "Danh tính nút không thay đổi."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Đã cập nhật danh tính nút. Nút sẽ được quét lại từ chu kỳ tiếp theo."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Ánh xạ thiết bị đã được chuyển sang nút mới."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Không thể xác nhận đề xuất. Các nút có thể đã thay đổi kể từ khi đề xuất được tạo."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Không thể từ chối đề xuất."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "Đã từ chối đề xuất."

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "Ánh xạ nút không thay đổi. %s"

#: fabric_admin.php
msgid "The node mapping was not changed."
msgstr "Ánh xạ nút không thay đổi."

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "Đã lưu ánh xạ nút."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "Không có thiết bị nào được tạo. Xem nhật ký Cacti."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "Thiết bị đã được tạo và nút đã được ánh xạ vào thiết bị đó. Chọn các cổng cần vẽ biểu đồ trên trang Biểu đồ mới."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "Không thể đọc danh mục để xuất."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "Các mẫu Fabric và tệp truy vấn dữ liệu đã được cài đặt."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "Các mẫu Fabric chưa được cài đặt. Xem bảng Đối tượng Cacti và nhật ký Cacti."

#: fabric_operator.php
msgid "Monitoring view"
msgstr "Chế độ xem giám sát"

#: fabric_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Không thể đọc các quan sát. Hãy yêu cầu quản trị viên kiểm tra nhật ký plugin."

#: include/operator.php
msgid "Inspect port validity, link width and speed, and the congestion view. Escalate identity conflicts and device relinking to an administrator; do not reset counters."
msgstr "Kiểm tra tính hợp lệ của cổng, độ rộng và tốc độ liên kết, cùng chế độ xem tắc nghẽn. Chuyển các xung đột danh tính và việc liên kết lại thiết bị lên quản trị viên; không đặt lại bộ đếm."

