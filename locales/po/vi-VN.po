#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: the inventory is %s; the last successful discovery was %s."
msgstr "Fabric %s: danh mục đang %s; lần phát hiện thành công gần nhất là %s."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "Fabric %s: được gán cho poller %d, nhưng chỉ poller chính mới có thể quét fabric cho đến khi hỗ trợ poller từ xa được bổ sung. Fabric này không được quét; hãy gán nó cho poller chính."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabric %s: không thể đọc bản ghi tình trạng của fabric này, nên trạng thái phát hiện không xác định. Xem nhật ký Cacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: chưa được phát hiện. Quá trình quét chỉ bắt đầu từ một nút đã ánh xạ tới thiết bị Cacti, vì vậy hãy chạy \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" một lần trên poller chính."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: chưa có nút nào được ánh xạ tới thiết bị Cacti, nên không có lần quét nào bắt đầu và danh mục không được làm mới. Hãy ánh xạ một nút trên trang Quản trị Fabric, hoặc chạy \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" trên poller chính."

#: lib/HealthPage.php
