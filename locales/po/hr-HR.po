#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "Čvor se izmijenio nakon prikaza stranice pa nije izvršena nijedna radnja. Pregledajte stanje i pokušajte ponovno."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Vaša dopuštenja za uređaje ne dopuštaju izmjenu ovog zapisa."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Naziv: drugi fabric već rabi ovaj naziv."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Prilagodnik: drugi fabric već očitava ovaj priključak prilagodnika na ovom polleru. Dopušten je samo jedan fabric po priključku prilagodnika."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Nije moguće spremiti fabric."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "Fabric je spremljen."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Očitavanje ovog fabrica je u tijeku pa ništa nije izbrisano. Pokušajte ponovno kada dovrši."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "Fabric i njegov inventar su izbrisani. Nijedan uređaj u sustavu Cacti nije izmijenjen, a s fabricom nije uspostavljena komunikacija."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Nije moguće izbrisati fabric."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "Identitet čvora nije izmijenjen."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Identitet čvora je ažuriran. Očitavanje se nastavlja od sljedećeg ciklusa."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Pridruživanje uređaja premješteno je na novi čvor."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Prijedlog nije moguće potvrditi. Čvorovi su se možda promijenili otkad je stvoren."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Prijedlog nije moguće odbaciti."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "Prijedlog je odbačen."

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "Pridruživanje čvora nije izmijenjeno. %s"

#: fabric_admin.php
msgid "The node mapping was not changed."
msgstr "Pridruživanje čvora nije izmijenjeno."

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "Pridruživanje čvora je spremljeno."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "Nije stvoren nijedan uređaj. Provjerite dnevnik sustava Cacti."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "Uređaj je stvoren i čvor mu je pridružen. Odaberite priključke za iscrtavanje na stranici Novi grafovi."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "Nije moguće pročitati inventar za izvoz."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "Predlošci Fabric i datoteka upita za podatke uspješno su instalirani."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "Predlošci Fabric nisu instalirani. Provjerite tablicu Objekti sustava Cacti i dnevnik sustava Cacti."

#: fabric_operator.php
msgid "Monitoring view"
msgstr "Nadzorni prikaz"

#: fabric_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Opažanja nije moguće pročitati. Zamolite administratora da provjeri dnevnik dodatka."

#: include/operator.php
msgid "Inspect port validity, link width and speed, and the congestion view. Escalate identity conflicts and device relinking to an administrator; do not reset counters."
msgstr "Pregledajte valjanost priključaka, širinu i brzinu veze te prikaz zagušenja. Sukobe identiteta i ponovno povezivanje uređaja proslijedite administratoru; nemojte poništavati brojače."

