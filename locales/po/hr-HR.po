#, php-format
msgid "Fabric %s: the inventory is %s; the last successful discovery was %s."
msgstr "Fabric %s: inventar je %s; posljednje uspješno otkrivanje zabilježeno je %s."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "Fabric %s: dodijeljen je polleru %d, ali samo glavni poller može očitavati fabric dok se ne doda podrška za udaljene pollere. Ne očitava se; dodijelite ga glavnom polleru."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabric %s: zapis o ispravnosti nije moguće pročitati pa je stanje otkrivanja nepoznato. Provjerite dnevnik sustava Cacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: još nije otkriven. Očitavanja se pokreću samo s čvora pridruženog uređaju sustava Cacti, stoga jednom pokrenite naredbu \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" na glavnom polleru."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: nijedan čvor nije pridružen uređaju sustava Cacti pa se očitavanje ne pokreće i inventar se ne osvježava. Pridružite čvor na stranici Upravljanje Fabricom ili pokrenite naredbu \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" na glavnom polleru."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabric %s: nije moguće pročitati %d redaka izlaza alata iblinkinfo, najvjerojatnije zato što opis čvora oponaša izlaz alata. Ti čvorovi zadržavaju posljednja stanja veza."

