#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Predlošci Fabric nisu instalirani. Ponovno ih instalirajte sa stranice ispravnosti."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Čvor je već pridružen uređaju."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Fabric ovog čvora ne očitava glavni poller pa se njegov uređaj ne može ispitivati."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Uređaj ne postoji."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Uređaj ispituje drugi poller od onoga koji očitava ovaj fabric pa ne može čitati predmemoriju fabrica."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Uređaj \"%s\" iz predloška uređaja %s, naziv računala %s, ispituje ga poller %d, s isključenim provjerama dostupnosti i SNMP-om."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Upit za podatke %s dodijeljen uređaju, koji sadrži popis priključaka čvora. Samostalno ne stvara grafove niti izvore podataka."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Stvorio dodatak Fabric za čvor %s. Njegove vrijednosti potječu iz predmemorije dodatka; naziv računala je rezervirani naziv s kojim se nikada ne komunicira."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Naziv: upotrijebite 1 do 64 slova, znamenke, razmake, točke, crtice ili podvlake, počevši slovom ili znamenkom."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Pozadinski sustav: odaberite jedan s popisa."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: odaberite jedan s popisa."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: samo glavni poller može očitavati fabric dok se ne doda podrška za udaljene pollere."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Razdoblje očitavanja: unesite cijeli broj sekundi od %d do %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Prilagodnik: unesite naziv lokalnog prilagodnika kako ga imenuje jezgra sustava, primjerice mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Priključak prilagodnika: unesite broj priključka lokalnog prilagodnika, od 1 do %d."

