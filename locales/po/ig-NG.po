#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Enweghị ike ịjụ atụmatụ ahụ."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "Ajụrụ atụmatụ ahụ."

