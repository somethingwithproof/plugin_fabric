msgid "Your device permissions do not allow changing this record."
msgstr "Ikike ngwaọrụ gị anaghị ekwe ka ị gbanwee ndekọ a."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Aha: fabric ọzọ na-eji aha a ugbu a."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Adapter: fabric ọzọ na-enyocha ọdụ adapter a na poller a ugbu a. Otu fabric maka otu ọdụ adapter."

