#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: achọpụtabeghị ya. Nnyocha na-amalite naanị site na node atụrụ na ngwaọrụ Cacti, ya mere gbaa \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" na main poller otu ugboro."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: enweghị node ọ bụla atụrụ na ngwaọrụ Cacti, ya mere nnyocha anaghị amalite ma anaghị emegharị ndekọ ihe ahụ. Tụọ node na ibe Nchịkwa Fabric, maọbụ gbaa \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" na main poller."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabric %s: enweghị ike ịgụ ahịrị iblinkinfo %d, o yikarịrị n'ihi na nkọwa node na-eṅomi mpụtara ngwaọrụ ahụ. Node ndị ahụ na-edobe ọnọdụ njikọ ikpeazụ ha."

