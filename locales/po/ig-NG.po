msgid "The device does not exist."
msgstr "Ngwaọrụ ahụ adịghị."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Poller ọzọ dị iche na nke na-enyocha fabric a na-enyocha ngwaọrụ ahụ, ya mere o nweghị ike ịgụ nchekwa nwa oge fabric."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Ngwaọrụ \"%s\" sitere na ndebiri ngwaọrụ %s, aha host %s, nke poller %d na-enyocha, na nlele nnweta na SNMP agbanyụrụ."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Ajụjụ data %s dị na ya, na-edepụta ọdụ nke node ahụ. Ọ naghị ekepụta eserese maọbụ isi mmalite data n'onwe ya."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Plugin Fabric kepụtara ya maka node %s. Ọnụọgụgụ ya sitere na nchekwa nwa oge plugin; aha host ahụ bụ aha echekwara nke a na-anaghị akpọtụrụ."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Aha: jiri mkpụrụedemede, ọnụọgụgụ, oghere, ntụpọ, ahịrị etiti, maọbụ ahịrị okpuru 1 ruo 64, malite na mkpụrụedemede maọbụ ọnụọgụgụ."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Backend: họrọ otu n'ime backend ndị e depụtara."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: họrọ otu n'ime poller ndị e depụtara."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: naanị main poller nwere ike ịnyocha fabric ruo mgbe agbakwụnyere nkwado remote poller."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Oge nnyocha: tinye sekọnd zuru oke site na %d ruo %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adapter: tinye aha adapter mpaghara dị ka kernel si akpọ ya, dị ka mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Ọdụ Adapter: tinye nọmba ọdụ nke adapter mpaghara, site na 1 ruo %d."

