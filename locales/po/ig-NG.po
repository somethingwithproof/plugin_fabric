msgid "The node identity was not changed."
msgstr "Agbanweghị njirimara node ahụ."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Emelitere njirimara node ahụ. A ga-enyocha ya ọzọ site na okirikiri na-abịa."

