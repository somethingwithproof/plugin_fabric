#, php-format
msgid "The Fabric plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "ปลั๊กอิน Fabric ต้องการ PHP %s หรือใหม่กว่า เซิร์ฟเวอร์นี้รัน PHP %s จึงไม่ได้ติดตั้งหรือเปิดใช้งานปลั๊กอิน"

#: setup.php
msgid "The Fabric plugin is not enabled."
msgstr "ปลั๊กอิน Fabric ไม่ได้เปิดใช้งานอยู่"

#: setup.php
#, php-format
msgid "The Fabric plugin requires PHP %s or later."
