#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "O nó foi alterado após o carregamento da página, portanto nada foi feito. Revise-o e tente novamente."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Suas permissões de dispositivo não permitem alterar este registro."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Nome: outro fabric já usa este nome."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Adaptador: outro fabric já varre esta porta de adaptador neste poller. Apenas um fabric por porta de adaptador."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Não foi possível salvar o fabric."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "O fabric foi salvo."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Uma varredura deste fabric está em execução, portanto nada foi excluído. Tente novamente quando ela terminar."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "O fabric e seu inventário foram excluídos. Nenhum dispositivo do Cacti foi alterado e o fabric não foi contatado."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Não foi possível excluir o fabric."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "A identidade do nó não foi alterada."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "A identidade do nó foi atualizada. Ele será varrido novamente a partir do próximo ciclo."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "O mapeamento do dispositivo foi movido para o novo nó."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Não foi possível confirmar a proposta. Os nós podem ter sido alterados desde que ela foi criada."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Não foi possível rejeitar a proposta."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "A proposta foi rejeitada."

