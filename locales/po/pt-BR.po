msgstr "Poller: apenas o poller principal pode varrer um fabric até que o suporte a pollers remotos seja adicionado."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Intervalo de varredura: informe segundos inteiros de %d a %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adaptador: informe o nome do adaptador local conforme o kernel o nomeia, como mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Porta do adaptador: informe o número da porta do adaptador local, de 1 a %d."

