#: lib/PrivilegeProbe.php lib/ToolDirectory.php
msgid "A diagnostics tool has the setuid or setgid bit. The plugin never needs it."
msgstr "Misy fitaovana fitiliana manana bit setuid na setgid. Tsy mila izany mihitsy ny plugin."

#: lib/PrivilegeProbe.php
msgid "A diagnostics tool or its directory can be written by an account other than its owner, or by the poller account. Whoever can write it chooses what the poller runs."
msgstr "Ny fitaovana fitiliana na ny lahatahiriny dia azo soratan'ny kaonty hafa ankoatra ny tompony, na ny kaontin'ny poller. Izay mahasoratra ao no mifidy izay ampandehanin'ny poller."

#: lib/PrivilegeProbe.php
msgid "A umad device is readable or writable by every account, so any local user can query the fabric. Restrict it to a group."
msgstr "Ny fitaovana umad iray dia azon'ny kaonty rehetra vakina na soratana, ka ny mpampiasa eo an-toerana rehetra dia afaka manontany ny fabric. Ferana ho an'ny vondrona iray izany."

#: lib/PrivilegeProbe.php lib/ToolDirectory.php
