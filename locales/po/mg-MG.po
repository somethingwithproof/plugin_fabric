msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabric %s: tsy azo novakina ny firaketana momba ny fahasalamany, ka tsy fantatra ny toetry ny fitadiavany. Jereo ny firaketana Cacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: mbola tsy hita izany. Ny fisavana dia manomboka avy amin'ny node mifandray amin'ny fitaovana Cacti ihany, ka alefaso indray mandeha ao amin'ny poller fototra ny \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\"."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: tsy misy node mifandray amin'ny fitaovana Cacti, ka tsy misy fisavana manomboka ary tsy havaozina ny lisitry ny singa. Ampifandraiso ny node ao amin'ny pejy Fabric Admin, na alefaso ao amin'ny poller fototra ny \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\"."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabric %s: andalana iblinkinfo %d no tsy azo novakina, angamba satria maka tahaka ny valin'ilay fitaovana ny famaritana ny node iray. Mitazona ny toetry ny rohiny farany ireo node ireo."

