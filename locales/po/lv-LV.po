#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Komutācijas tīkla veidnes nav instalētas. Pārinstalējiet tās veselības lapā."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Mezgls jau ir piesaistīts ierīcei."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Mezgla komutācijas tīklu neapseko galvenais aptaujātājs, tāpēc tā ierīci nevarēja aptaujāt."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Ierīce neeksistē."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Ierīci aptaujā cits aptaujātājs, nevis tas, kas apseko šo komutācijas tīklu, tāpēc tā nevarēja nolasīt komutācijas tīkla kešatmiņu."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Ierīce \"%s\" no %s ierīces veidnes, resursdatora nosaukums %s, ko aptaujā aptaujātājs %d, ar izslēgtām pieejamības pārbaudēm un SNMP."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Datu vaicājums %s tajā, kas uzskaita mezgla portus. Pats par sevi tas neveido grafikus un datu avotus."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Izveidoja komutācijas tīkla spraudnis mezglam %s. Tās vērtības tiek ņemtas no spraudņa kešatmiņas; resursdatora nosaukums ir rezervēts nosaukums, ar kuru nekad netiek veidots savienojums."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nosaukums: izmantojiet 1 līdz 64 burtus, ciparus, atstarpes, punktus, domuzīmes vai pasvītras, sākot ar burtu vai ciparu."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Aizmugursistēma: izvēlieties vienu no uzskaitītajām aizmugursistēmām."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Aptaujātājs: izvēlieties vienu no uzskaitītajiem aptaujātājiem."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Aptaujātājs: līdz attālo aptaujātāju atbalsta pievienošanai komutācijas tīklu var apsekot tikai galvenais aptaujātājs."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Apsekošanas intervāls: ievadiet veselas sekundes no %d līdz %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adapteris: ievadiet lokālā adaptera nosaukumu tā, kā to nosauc kodols, piemēram, mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Adaptera ports: ievadiet lokālā adaptera porta numuru no 1 līdz %d."

