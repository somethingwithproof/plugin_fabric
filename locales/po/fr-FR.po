msgid "The node is already mapped to a device."
msgstr "Le nœud est déjà associé à un équipement."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "La fabrique du nœud n'est pas balayée par le collecteur principal ; son équipement n'a donc pas pu être interrogé."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "L'équipement n'existe pas."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "L'équipement est interrogé par un autre collecteur que celui qui balaie cette fabrique ; il n'a donc pas pu lire le cache de la fabrique."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Un équipement « %s » issu du modèle d'équipement %s, nom d'hôte %s, interrogé par le collecteur %d, avec les vérifications de disponibilité et SNMP désactivés."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "La requête de données %s associée, listant les ports du nœud. Elle ne crée aucun graphique ni aucune source de données par elle-même."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Créé par le plugin Fabric pour le nœud %s. Ses valeurs proviennent du cache du plugin ; le nom d'hôte est un nom réservé qui n'est jamais contacté."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nom : utilisez de 1 à 64 lettres, chiffres, espaces, points, tirets ou traits de soulignement, en commençant par une lettre ou un chiffre."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Backend : choisissez l'un des backends listés."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Collecteur : choisissez l'un des collecteurs listés."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Collecteur : seul le collecteur principal peut balayer une fabrique tant que la prise en charge des collecteurs distants n'est pas ajoutée."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Intervalle de balayage : saisissez un nombre entier de secondes entre %d et %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adaptateur : saisissez le nom de l'adaptateur local tel que le noyau le nomme, par exemple mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Port de l'adaptateur : saisissez le numéro de port de l'adaptateur local, de 1 à %d."

