#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "পৃষ্ঠাটি লোড হওয়ার পর নোডটি পরিবর্তিত হয়েছে, তাই কোনো কিছু করা হয়নি। এটি পর্যালোচনা করে আবার চেষ্টা করুন।"

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "আপনার ডিভাইস অনুমতি এই রেকর্ডটি পরিবর্তন করার অনুমতি দেয় না।"

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "নাম: অন্য একটি ফ্যাব্রিক ইতিমধ্যেই এই নামটি ব্যবহার করছে।"

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "অ্যাডাপ্টার: অন্য একটি ফ্যাব্রিক ইতিমধ্যেই এই পোলারে এই অ্যাডাপ্টার পোর্টটি সুইপ করছে। প্রতি অ্যাডাপ্টার পোর্টে একটি ফ্যাব্রিক অনুমোদিত।"

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "ফ্যাব্রিকটি সংরক্ষণ করা যায়নি।"

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "ফ্যাব্রিকটি সংরক্ষণ করা হয়েছে।"

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "এই ফ্যাব্রিকের একটি সুইপ চলছে, তাই কোনো কিছু মুছে ফেলা হয়নি। এটি শেষ হলে আবার চেষ্টা করুন।"

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "ফ্যাব্রিক এবং এর ইনভেন্টরি মুছে ফেলা হয়েছে। কোনো Cacti ডিভাইস পরিবর্তন করা হয়নি এবং ফ্যাব্রিকের সাথে যোগাযোগ করা হয়নি।"

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "ফ্যাব্রিকটি মুছে ফেলা যায়নি।"

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "নোডের পরিচয় পরিবর্তন করা হয়নি।"

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "নোডের পরিচয় আপডেট করা হয়েছে। পরবর্তী চক্র থেকে এটি আবার সুইপ করা হবে।"

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "ডিভাইস ম্যাপিং নতুন নোডে স্থানান্তরিত হয়েছে।"

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "প্রস্তাবটি নিশ্চিত করা যায়নি। এটি তৈরি করার পর নোডগুলো পরিবর্তিত হয়ে থাকতে পারে।"

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "প্রস্তাবটি প্রত্যাখ্যান করা যায়নি।"

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "প্রস্তাবটি প্রত্যাখ্যান করা হয়েছে।"

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "নোড ম্যাপিং পরিবর্তন করা হয়নি। %s"

#: fabric_admin.php
msgid "The node mapping was not changed."
msgstr "নোড ম্যাপিং পরিবর্তন করা হয়নি।"

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "নোড ম্যাপিং সংরক্ষণ করা হয়েছে।"

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "কোনো ডিভাইস তৈরি করা হয়নি। Cacti লগ দেখুন।"

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "ডিভাইসটি তৈরি করা হয়েছে এবং নোডটি এতে ম্যাপ করা হয়েছে। New Graphs পৃষ্ঠায় গ্রাফ করার জন্য পোর্টগুলো নির্বাচন করুন।"

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "এক্সপোর্টের জন্য ইনভেন্টরি পড়া যায়নি।"

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "Fabric টেমপ্লেট এবং ডেটা কোয়েরি ফাইল ইনস্টল করা হয়েছে।"

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "Fabric টেমপ্লেটগুলো ইনস্টল করা হয়নি। Cacti অবজেক্ট টেবিল এবং Cacti লগ দেখুন।"

#: fabric_operator.php
msgid "Monitoring view"
msgstr "মনিটরিং ভিউ"

#: fabric_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "পর্যবেক্ষণগুলো পড়া যায়নি। প্লাগইন লগ পরীক্ষা করতে একজন প্রশাসককে বলুন।"

#: include/operator.php
msgid "Inspect port validity, link width and speed, and the congestion view. Escalate identity conflicts and device relinking to an administrator; do not reset counters."
msgstr "পোর্টের বৈধতা, লিংকের প্রস্থ ও গতি এবং কনজেশন ভিউ পরীক্ষা করুন। পরিচয় সংক্রান্ত দ্বন্দ্ব এবং ডিভাইস রিলিংকিংয়ের বিষয়গুলো অ্যাডমিনিস্ট্রেটরের কাছে পাঠান; কাউন্টার রিসেট করবেন না।"

