#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "Fabric %s: yahawe poller %d, ariko poller y'ibanze yonyine ni yo ishobora gusuzuma fabric kugeza igihe uburyo bwa poller zo kure buzongerwamo. Ntisuzumwa; yihereze poller y'ibanze."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabric %s: inyandiko yayo y'ubuzima ntishobora gusomwa, bityo imiterere y'itahura ryayo ntizwi. Reba inyandiko-mvugo ya Cacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: ntabwo iratahurwa. Isuzuma ritangirira gusa kuri nodi ihujwe n'igikoresho cya Cacti, bityo koresha \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" kuri poller y'ibanze rimwe."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: nta nodi ihujwe n'igikoresho cya Cacti, bityo nta suzuma ritangira kandi urutonde rw'ibikoresho ntiruvugururwa. Huza nodi ku rupapuro rw'ubuyobozi bwa Fabric, cyangwa ukoreshe \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" kuri poller y'ibanze."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabric %s: imirongo %d ya iblinkinfo ntishobora gusomwa, birashoboka ko impamvu ari uko ibisobanuro bya nodi byigana ibisohoka mu gikoresho. Izo nodi zigumana imiterere yazo iheruka y'umuyoboro."

