#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "კვანძი შეიცვალა გვერდის ჩატვირთვის შემდეგ, ამიტომ არაფერი გაკეთებულა. გადახედეთ მას და სცადეთ თავიდან."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "თქვენი მოწყობილობის უფლებები არ იძლევა ამ ჩანაწერის შეცვლის საშუალებას."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "სახელი: სხვა ფაბრიკი უკვე იყენებს ამ სახელს."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "ადაპტერი: სხვა ფაბრიკი უკვე ასკანირებს ამ ადაპტერის პორტს ამ პოლერზე. ერთი ფაბრიკი თითო ადაპტერის პორტზე."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "ფაბრიკის შენახვა ვერ მოხერხდა."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "ფაბრიკი შენახულია."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "ამ ფაბრიკის სკანირება მიმდინარეობს, ამიტომ არაფერი წაშლილა. სცადეთ თავიდან დასრულების შემდეგ."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "ფაბრიკი და მისი ინვენტარი წაიშალა. არც ერთი Cacti მოწყობილობა არ შეცვლილა და ფაბრიკთან კავშირი არ დამყარებულა."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "ფაბრიკის წაშლა ვერ მოხერხდა."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "კვანძის იდენტობა არ შეცვლილა."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "კვანძის იდენტობა განახლდა. მისი სკანირება განახლდება მომდევნო ციკლიდან."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "მოწყობილობის მიბმა გადატანილია ახალ კვანძზე."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "წინადადების დადასტურება ვერ მოხერხდა. შესაძლოა კვანძები შეიცვალა მისი შექმნის შემდეგ."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "წინადადების უარყოფა ვერ მოხერხდა."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "წინადადება უარყოფილია."

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "კვანძის მიბმა არ შეცვლილა. %s"

#: fabric_admin.php
msgid "The node mapping was not changed."
msgstr "კვანძის მიბმა არ შეცვლილა."

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "კვანძის მიბმა შენახულია."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "მოწყობილობა არ შეიქმნა. იხილეთ Cacti-ს ჟურნალი."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "მოწყობილობა შეიქმნა და კვანძი მასზე მიბმულია. აირჩიეთ გრაფიკზე გამოსატანი პორტები „ახალი გრაფიკების“ გვერდზე."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "ექსპორტისთვის ინვენტარის წაკითხვა ვერ მოხერხდა."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "ფაბრიკის შაბლონები და მონაცემთა მოთხოვნის ფაილი დაყენებულია."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "ფაბრიკის შაბლონები არ დაყენდა. იხილეთ Cacti ობიექტების ცხრილი და Cacti-ს ჟურნალი."

#: fabric_operator.php
msgid "Monitoring view"
msgstr "მონიტორინგის ხედი"

#: fabric_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "დაკვირვებების წაკითხვა ვერ მოხერხდა. სთხოვეთ ადმინისტრატორს შეამოწმოს დანამატის ჟურნალი."

#: include/operator.php
msgid "Inspect port validity, link width and speed, and the congestion view. Escalate identity conflicts and device relinking to an administrator; do not reset counters."
msgstr "შეამოწმეთ პორტების ვალიდურობა, ბმულის სიგანე და სიჩქარე და გადატვირთვის ხედი. იდენტობის კონფლიქტები და მოწყობილობების ხელახლა მიბმა გადაეცით ადმინისტრატორს; არ გაანულოთ მთვლელები."

