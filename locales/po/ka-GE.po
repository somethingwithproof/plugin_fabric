#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "მოწყობილობას კითხავს სხვა პოლერი და არა ის, რომელიც ამ ფაბრიკს ასკანირებს, ამიტომ იგი ვერ წაიკითხავს ფაბრიკის ქეშს."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "მოწყობილობა \"%s\" მოწყობილობის შაბლონიდან %s, ჰოსტის სახელით %s, გამოკითხული პოლერით %d, ხელმისაწვდომობის შემოწმებისა და SNMP-ის გამორთვით."

#: lib/DeviceProvisioner.php
#, php-format
