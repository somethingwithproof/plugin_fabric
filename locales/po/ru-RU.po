#: lib/CommandError.php
msgid "The fabric or plugin settings are incomplete or invalid"
msgstr "Настройки фабрики или плагина неполны или некорректны"

#: lib/CommandError.php
msgid "The tool is missing or not executable in the configured directory"
msgstr "Утилита отсутствует или не является исполняемой в настроенном каталоге"

#: lib/CommandError.php
msgid "The tool exceeded its time limit and was stopped"
msgstr "Утилита превысила ограничение по времени и была остановлена"

#: lib/CommandError.php
msgid "The tool output exceeded the size limit and was discarded"
msgstr "Вывод утилиты превысил ограничение по размеру и был отброшен"

#: lib/CommandError.php
msgid "The tool failed"
msgstr "Сбой выполнения утилиты"

#: lib/CommandError.php
msgid "The tool output did not have the expected form"
msgstr "Вывод утилиты не соответствует ожидаемому формату"

#: lib/CommandError.php
msgid "Not attempted: the time or failure budget was spent"
msgstr "Не выполнялось: исчерпан лимит времени или ошибок"

#: lib/CommandError.php
msgid "The plugin tables could not be read or written"
msgstr "Не удалось выполнить чтение или запись таблиц плагина"

#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Шаблоны Fabric не установлены. Переустановите их со страницы состояния."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Узел уже привязан к устройству."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Фабрика этого узла не сканируется основным опросчиком, поэтому его устройство не может быть опрошено."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Устройство не существует."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Устройство опрашивается другим опросчиком, отличным от того, который сканирует эту фабрику, поэтому оно не может прочитать кэш фабрики."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Устройство \"%s\" на основе шаблона устройства %s, имя хоста %s, опрашиваемое опросчиком %d, с отключёнными проверками доступности и SNMP."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Запрос данных %s для него со списком портов узла. Сам по себе он не создаёт ни графиков, ни источников данных."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Создано плагином Fabric для узла %s. Его значения берутся из кэша плагина; имя хоста является зарезервированным и к нему никогда не выполняются обращения."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Имя: используйте от 1 до 64 букв, цифр, пробелов, точек, дефисов или знаков подчёркивания, начиная с буквы или цифры."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Бэкенд: выберите один из перечисленных бэкендов."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Опросчик: выберите один из перечисленных опросчиков."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Опросчик: сканировать фабрику может только основной опросчик, пока не будет добавлена поддержка удалённых опросчиков."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Интервал сканирования: введите целое число секунд от %d до %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Адаптер: введите имя локального адаптера так, как его называет ядро, например mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Порт адаптера: введите номер порта локального адаптера от 1 до %d."

