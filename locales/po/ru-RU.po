#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: the inventory is %s; the last successful discovery was %s."
msgstr "Фабрика %s: состояние инвентаризации — %s; последнее успешное обнаружение — %s."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "Фабрика %s: она назначена опросчику %d, но сканировать фабрику может только основной опросчик, пока не будет добавлена поддержка удалённых опросчиков. Сканирование не выполняется; назначьте её основному опросчику."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Фабрика %s: не удалось прочитать её запись о состоянии, поэтому статус обнаружения неизвестен. Подробности см. в журнале Cacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Фабрика %s: она ещё не была обнаружена. Сканирование запускается только с узла, привязанного к устройству Cacti, поэтому выполните один раз на основном опросчике команду \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\"."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Фабрика %s: ни один узел не привязан к устройству Cacti, поэтому сканирование не запускается, а инвентарные данные не обновляются. Привяжите узел на странице «Управление Fabric» или выполните на основном опросчике команду \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\"."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Фабрика %s: не удалось прочитать строк iblinkinfo: %d, вероятнее всего из-за того, что описание узла имитирует вывод утилиты. Эти узлы сохраняют свои последние состояния каналов."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %s"
msgstr "Фабрика %s: %s"

