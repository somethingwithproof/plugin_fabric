#: lib/CommandError.php
msgid "The fabric or plugin settings are incomplete or invalid"
msgstr "Налаштування фабрики або плагіна неповні чи недійсні"

#: lib/CommandError.php
msgid "The tool is missing or not executable in the configured directory"
msgstr "Інструмент відсутній або не є виконуваним у налаштованому каталозі"

#: lib/CommandError.php
msgid "The tool exceeded its time limit and was stopped"
msgstr "Інструмент перевищив ліміт часу та був зупинений"

#: lib/CommandError.php
msgid "The tool output exceeded the size limit and was discarded"
msgstr "Вивід інструмента перевищив обмеження розміру та був відкинутий"

#: lib/CommandError.php
msgid "The tool failed"
msgstr "Помилка виконання інструмента"

#: lib/CommandError.php
msgid "The tool output did not have the expected form"
msgstr "Вивід інструмента мав неочікуваний формат"

#: lib/CommandError.php
msgid "Not attempted: the time or failure budget was spent"
msgstr "Спробу не виконано: вичерпано ліміт часу або помилок"

#: lib/CommandError.php
msgid "The plugin tables could not be read or written"
msgstr "Не вдалося прочитати або записати таблиці плагіна"

#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Шаблони Fabric не встановлено. Перевстановіть їх зі сторінки стану."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Вузол уже прив’язано до пристрою."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Фабрику цього вузла не сканує головний опитувач, тому його пристрій не може опитуватися."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Пристрій не існує."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Пристрій опитується іншим опитувачем, ніж той, що сканує цю фабрику, тому він не може прочитати кеш фабрики."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Пристрій \"%s\" із шаблону пристрою %s, ім’я хоста %s, опитується опитувачем %d, із вимкненими перевірками доступності та SNMP."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Запит даних %s на ньому, що містить перелік портів вузла. Сам по собі він не створює жодних графіків і джерел даних."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Створено плагіном Fabric для вузла %s. Значення надходять із кешу плагіна; ім’я хоста є зарезервованим і підключення до нього ніколи не виконується."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Назва: використовуйте від 1 до 64 літер, цифр, пробілів, крапок, дефісів або символів підкреслення, починаючи з літери чи цифри."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Бекенд: виберіть один із перелічених бекендів."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Опитувач: виберіть один із перелічених опитувачів."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Опитувач: доки не додано підтримку віддалених опитувачів, сканувати фабрику може лише головний опитувач."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Інтервал сканування: введіть цілу кількість секунд від %d до %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Адаптер: введіть назву локального адаптера так, як її позначає ядро, наприклад mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Порт адаптера: введіть номер порту локального адаптера від 1 до %d."

