msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Utambulisho wa nodi ulisasishwa. Unafagiwa tena kuanzia mzunguko ujao."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Uunganishaji wa kifaa ulihamishiwa kwenye nodi mpya."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Pendekezo halikuweza kuthibitishwa. Nodi huenda zimebadilika tangu lilipofanywa."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Pendekezo halikuweza kukataliwa."

#: fabric_admin.php
