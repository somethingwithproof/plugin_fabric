msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: haijagunduliwa. Ufagiaji huanza tu kutoka kwa nodi iliyounganishwa na kifaa cha Cacti, kwa hivyo endesha \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" kwenye poller kuu mara moja."

