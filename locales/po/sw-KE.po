#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "Nodi ilibadilika baada ya ukurasa kuchorwa, kwa hivyo hakuna kilichofanyika. Ikague na ujaribu tena."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Ruhusa zako za kifaa haziruhusu kubadilisha rekodi hii."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Jina: fabric nyingine tayari inatumia jina hili."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Adapta: fabric nyingine tayari inafagia mlango huu wa adapta kwenye poller hii. Fabric moja kwa kila mlango wa adapta."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Fabric haikuweza kuhifadhiwa."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "Fabric ilihifadhiwa."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Ufagiaji wa fabric hii unaendelea, kwa hivyo hakuna kilichofutwa. Jaribu tena itakapomalizika."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "Fabric na orodha yake ya rasilimali zilifutwa. Hakuna kifaa cha Cacti kilichobadilishwa na fabric haikuwasiliwa."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Fabric haikuweza kufutwa."

