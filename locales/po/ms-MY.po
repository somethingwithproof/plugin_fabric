msgid "Fabric %s: the inventory is %s; the last successful discovery was %s."
msgstr "Fabrik %s: inventori adalah %s; penemuan berjaya terakhir adalah %s."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "Fabrik %s: ia diperuntukkan kepada poller %d, tetapi hanya poller utama boleh menyapu fabrik sehingga sokongan poller jauh ditambahkan. Ia tidak disapu; peruntukkannya kepada poller utama."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabrik %s: rekod kesihatannya tidak dapat dibaca, jadi keadaan penemuannya tidak diketahui. Lihat log Cacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabrik %s: ia belum ditemui. Sapuan bermula hanya daripada nod yang dipetakan kepada peranti Cacti, jadi jalankan \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" pada poller utama sekali."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabrik %s: tiada nod dipetakan kepada peranti Cacti, jadi tiada sapuan bermula dan inventori tidak disegarkan semula. Petakan nod pada halaman Pentadbiran Fabric, atau jalankan \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" pada poller utama."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabrik %s: %d baris iblinkinfo tidak dapat dibaca, berkemungkinan besar kerana perihalan nod meniru output alat tersebut. Nod tersebut mengekalkan keadaan pautan terakhirnya."

