#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Templat Fabric belum dipasang. Pasang semula dari halaman kesihatan."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Nod sudah dipetakan kepada satu peranti."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Fabrik nod ini tidak disapu oleh poller utama, jadi perantinya tidak dapat diundi."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Peranti tidak wujud."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Peranti ini diundi oleh poller yang berbeza daripada poller yang menyapu fabrik ini, jadi ia tidak dapat membaca cache fabrik."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Peranti \"%s\" daripada templat peranti %s, nama hos %s, diundi oleh poller %d, dengan semakan ketersediaan dan SNMP dimatikan."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Pertanyaan data %s padanya, yang menyenaraikan port nod tersebut. Ia tidak mencipta sebarang graf dan sumber data dengan sendirinya."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Dicipta oleh pemalam Fabric untuk nod %s. Nilainya datang daripada cache pemalam; nama hos adalah nama terpelihara yang tidak pernah dihubungi."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nama: gunakan 1 hingga 64 huruf, digit, ruang, titik, sempang, atau garis bawah, bermula dengan huruf atau digit."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Backend: pilih salah satu backend yang disenaraikan."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: pilih salah satu poller yang disenaraikan."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: hanya poller utama boleh menyapu fabrik sehingga sokongan poller jauh ditambahkan."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Selang Sapuan: masukkan saat bulat dari %d hingga %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Penyesuai: masukkan nama penyesuai setempat seperti yang dinamakan oleh kernel, seperti mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Port Penyesuai: masukkan nombor port bagi penyesuai setempat, dari 1 hingga %d."

