#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "הצומת השתנה לאחר טעינת הדף, ולכן לא בוצעה כל פעולה. יש לבדוק אותו ולנסות שוב."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "הרשאות ההתקן שלך אינן מאפשרות לשנות רשומה זו."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "שם: מארג אחר כבר משתמש בשם זה."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "מתאם: מארג אחר כבר סורק יציאת מתאם זו בדוגם זה. מארג אחד לכל יציאת מתאם."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "לא ניתן היה לשמור את המארג."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "המארג נשמר."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "סריקה של מארג זה פועלת כעת, ולכן לא נמחק דבר. יש לנסות שוב לאחר סיומה."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "המארג והמלאי שלו נמחקו. אף התקן Cacti לא שונה ולא נוצר קשר עם המארג."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "לא ניתן היה למחוק את המארג."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "זהות הצומת לא שונתה."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "זהות הצומת עודכנה. היא תיסרק מחדש החל מהמחזור הבא."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "מיפוי ההתקן הועבר לצומת החדש."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "לא ניתן היה לאשר את ההצעה. ייתכן שהצמתים השתנו מאז שנוצרה."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "לא ניתן היה לדחות את ההצעה."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "ההצעה נדחתה."

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "מיפוי הצומת לא שונה. %s"

#: fabric_admin.php
msgid "The node mapping was not changed."
msgstr "מיפוי הצומת לא שונה."

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "מיפוי הצומת נשמר."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "לא נוצר התקן. יש לעיין ביומן Cacti."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "ההתקן נוצר והצומת מופה אליו. יש לבחור את היציאות ליצירת גרפים בדף 'גרפים חדשים'."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "לא ניתן היה לקרוא את המלאי לצורך ייצוא."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "תבניות Fabric וקובץ שאילתת הנתונים הותקנו."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "תבניות Fabric לא הותקנו. יש לעיין בטבלת אובייקטי Cacti וביומן Cacti."

#: fabric_operator.php
msgid "Monitoring view"
msgstr "תצוגת ניטור"

#: fabric_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "לא ניתן היה לקרוא תצפיות. בקש ממנהל המערכת לבדוק את יומן התוסף."

#: include/operator.php
msgid "Inspect port validity, link width and speed, and the congestion view. Escalate identity conflicts and device relinking to an administrator; do not reset counters."
msgstr "יש לבדוק את תקינות היציאות, רוחב הקישור ומהירותו, ואת תצוגת העומסים. יש להעביר התנגשויות זהות וקישור מחדש של התקנים לטיפול מנהל המערכת; אין לאפס מונים."

