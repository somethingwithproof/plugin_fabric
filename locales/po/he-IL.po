#: lib/PrivilegeProbe.php
msgid "The sweep runs as root. Run the poller as an unprivileged account with read access to the umad devices through a group."
msgstr "הסריקה רצה כ-root. הפעל את הדוגם תחת חשבון ללא הרשאות עם גישת קריאה להתקני umad דרך קבוצה."

#: lib/PrivilegeProbe.php lib/ToolDirectory.php
msgid "A diagnostics tool has the setuid or setgid bit. The plugin never needs it."
msgstr "לכלי אבחון מוגדרת סיבית setuid או setgid. התוסף לעולם אינו זקוק לכך."

#: lib/PrivilegeProbe.php
msgid "A diagnostics tool or its directory can be written by an account other than its owner, or by the poller account. Whoever can write it chooses what the poller runs."
msgstr "כלי אבחון או התיקייה שלו ניתנים לכתיבה על ידי חשבון שאינו הבעלים שלו, או על ידי חשבון הדוגם. מי שיכול לכתוב לשם קובע מה הדוגם יריץ."

#: lib/PrivilegeProbe.php
msgid "A umad device is readable or writable by every account, so any local user can query the fabric. Restrict it to a group."
msgstr "התקן umad ניתן לקריאה או לכתיבה על ידי כל חשבון, כך שכל משתמש מקומי יכול לתשאל את המארג. הגבל אותו לקבוצה."

#: lib/PrivilegeProbe.php lib/ToolDirectory.php
msgid "Unknown warning"
msgstr "אזהרה לא ידועה"

#: lib/Settings.php
msgid "Diagnostics Tools"
msgstr "כלי אבחון"

#: lib/Settings.php
msgid "Absolute directory, on each poller that sweeps a fabric, holding perfquery, ibnetdiscover, and iblinkinfo. The Debian and Ubuntu packages install them in /usr/sbin. No other program is ever run from it."
msgstr "תיקייה מוחלטת, בכל דוגם הסורק מארג, המכילה את perfquery, ibnetdiscover ו-iblinkinfo. חבילות Debian ו-Ubuntu מתקינות אותם ב-/usr/sbin. שום תוכנית אחרת אינה מורצת משם."

#: lib/Settings.php
msgid "Tool Directory"
msgstr "תיקיית כלים"

#: lib/Settings.php
msgid "Node Name Map"
msgstr "מפת שמות צמתים"

#: lib/Settings.php
msgid "Optional absolute path to an infiniband-diags node name map file. Names it supplies are shown only; identity is always the node GUID."
msgstr "נתיב מוחלט אופציונלי לקובץ מפת שמות צמתים של infiniband-diags. השמות שהוא מספק משמשים לתצוגה בלבד; הזהות היא תמיד ה-GUID של הצומת."

#: lib/Settings.php
msgid "Datagram Timeout"
msgstr "פסק זמן ל-Datagram"

#: lib/Settings.php
msgid "Milliseconds each management datagram may take before the tools retry it (their -t option)."
msgstr "מילישניות שכל datagram ניהול רשאי להימשך לפני שהכלים ינסו אותו שוב (האפשרות -t שלהם)."

#: lib/Settings.php
msgid "Command Timeout"
msgstr "פסק זמן לפקודה"

#: lib/Settings.php
msgid "Seconds one tool run may take before it is stopped and recorded as failed."
msgstr "שניות שהרצת כלי אחת רשאית להימשך לפני שהיא נעצרת ונרשמת ככישלון."

#: lib/Settings.php
msgid "KiB one tool run may print. Larger output is discarded and recorded as failed."
msgstr "KiB שהרצת כלי אחת רשאית להדפיס. פלט גדול יותר נזרק ונרשם ככישלון."

#: lib/Settings.php
msgid "Maximum Output"
msgstr "פלט מרבי"

#: lib/Settings.php
msgid "Sweep"
msgstr "סריקה"

#: lib/Settings.php
msgid "Node Time Budget"
msgstr "תקציב זמן לצומת"

#: lib/Settings.php
msgid "Seconds one node sweep may spend reading counters. Ports not reached are read in the next cycle."
msgstr "שניות שסריקת צומת אחת רשאית להקדיש לקריאת מונים. יציאות שלא הושגו ייקראו במחזור הבא."

#: lib/Settings.php
msgid "Failed ports after which a node sweep stops for this cycle. A port that does not answer costs several seconds."
msgstr "מספר יציאות כושלות שלאחריו סריקת צומת נעצרת למחזור זה. יציאה שאינה מגיבה עולה במספר שניות."

#: lib/Settings.php
msgid "Node Failure Budget"
msgstr "תקציב כשלים לצומת"

#: lib/Settings.php
msgid "Index Down Ports"
msgstr "מיפתוח יציאות לא זמינות"

#: lib/Settings.php
msgid "When checked, the Fabric Port data query also lists ports that are down and have no remote end, such as unused adapter ports. Cleared, they are left out until they come up."
msgstr "כאשר מסומן, שאילתת הנתונים Fabric Port מציגה גם יציאות שאינן זמינות ואין להן קצה מרוחק, כגון יציאות מתאם שאינן בשימוש. כאשר אינו מסומן, הן מושמטות עד שיהפכו לזמינות."

#: lib/Settings.php
msgid "Uninstall"
msgstr "הסרת התקנה"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "שמור את טבלאות התוסף בעת הסרת ההתקנה"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its fabrics, inventory, and samples. Clear it to have the uninstall drop them; export the inventory first from the Fabric Admin page. The fabric is never contacted either way."
msgstr "כאשר מסומן, הסרת ההתקנה של התוסף שומרת על המארגים, המלאי והדגימות שלו. בטל את הסימון כדי שהסרת ההתקנה תמחק אותם; ייצא תחילה את המלאי מדף Fabric Admin. בכל מקרה אין פנייה למארג."

#: lib/ToolDirectory.php
msgid "The tool directory must be an absolute path of letters, digits, dots, dashes, underscores, and slashes, with no trailing slash."
msgstr "תיקיית הכלים חייבת להיות נתיב מוחלט המורכב מאותיות, ספרות, נקודות, מקפים, קווים תחתונים ולוכסנים, ללא לוכסן בסוף."

#: lib/ToolDirectory.php
msgid "The tool directory does not exist or is not a directory."
msgstr "תיקיית הכלים אינה קיימת או שאינה תיקייה."

#: lib/ToolDirectory.php
msgid "The tool directory path contains a symbolic link. Enter the real path."
msgstr "נתיב תיקיית הכלים מכיל קישור סימבולי. הזן את הנתיב האמיתי."

#: lib/ToolDirectory.php
msgid "The tool directory is not owned by root."
msgstr "תיקיית הכלים אינה בבעלות root."

#: lib/ToolDirectory.php
msgid "The tool directory can be written by its group or by others."
msgstr "תיקיית הכלים ניתנת לכתיבה על ידי הקבוצה שלה או על ידי אחרים."

#: lib/ToolDirectory.php
msgid "A diagnostics tool is not owned by root."
msgstr "כלי אבחון אינו בבעלות root."

#: lib/ToolDirectory.php
msgid "A diagnostics tool can be written by its group or by others."
msgstr "כלי אבחון ניתן לכתיבה על ידי הקבוצה שלו או על ידי אחרים."

