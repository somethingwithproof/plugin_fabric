#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "תבניות Fabric אינן מותקנות. יש להתקין אותן מחדש מדף התקינות."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "הצומת כבר ממופה להתקן."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "המארג של הצומת אינו נסרק על ידי הדוגם הראשי, ולכן לא ניתן היה לדגום את ההתקן שלו."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "ההתקן אינו קיים."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "ההתקן נדגם על ידי דוגם אחר מזה שסורק מארג זה, ולכן לא ניתן היה לקרוא את מטמון המארג."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "התקן \"%s\" מתבנית ההתקן %s, שם מארח %s, הנדגם על ידי דוגם %d, כאשר בדיקות הזמינות ו-SNMP כבויים."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "שאילתת הנתונים %s עליו, המפרטת את יציאות הצומת. היא אינה יוצרת גרף או מקור נתונים בפני עצמה."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "נוצר על ידי התוסף Fabric עבור צומת %s. ערכיו מגיעים ממטמון התוסף; שם המארח הוא שם שמור שלעולם אין יוצרים עמו קשר."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "שם: יש להשתמש ב-1 עד 64 אותיות, ספרות, רווחים, נקודות, מקפים או קווים תחתונים, המתחילים באות או בספרה."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "מנוע עורפי: יש לבחור באחד מהמנועים העורפיים הרשומים."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "דוגם: יש לבחור באחד מהדוגמים הרשומים."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "דוגם: רק הדוגם הראשי יכול לסרוק מארג עד שתתווסף תמיכה בדוגם מרוחק."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "מרווח סריקה: יש להזין שניות שלמות בין %d ל-%d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "מתאם: יש להזין את שם המתאם המקומי כפי שהקרנל מכנה אותו, כגון mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "יציאת מתאם: יש להזין את מספר היציאה של המתאם המקומי, מ-1 עד %d."

