#: lib/CommandError.php
msgid "The fabric or plugin settings are incomplete or invalid"
msgstr "فیبرک یا پلگ ان کی ترتیبات نامکمل یا غلط ہیں"

#: lib/CommandError.php
msgid "The tool is missing or not executable in the configured directory"
msgstr "ترتیب دی گئی ڈائریکٹری میں ٹول غائب ہے یا قابلِ عمل (executable) نہیں ہے"

#: lib/CommandError.php
msgid "The tool exceeded its time limit and was stopped"
msgstr "ٹول اپنے وقت کی حد سے تجاوز کر گیا اور اسے روک دیا گیا"

#: lib/CommandError.php
msgid "The tool output exceeded the size limit and was discarded"
msgstr "ٹول کا آؤٹ پٹ حجم کی حد سے تجاوز کر گیا اور اسے رد کر دیا گیا"

#: lib/CommandError.php
msgid "The tool failed"
msgstr "ٹول ناکام ہو گیا"

#: lib/CommandError.php
msgid "The tool output did not have the expected form"
msgstr "ٹول کا آؤٹ پٹ متوقع شکل میں نہیں تھا"

#: lib/CommandError.php
msgid "Not attempted: the time or failure budget was spent"
msgstr "کوشش نہیں کی گئی: وقت یا ناکامی کا بجٹ ختم ہو گیا تھا"

#: lib/CommandError.php
msgid "The plugin tables could not be read or written"
msgstr "پلگ ان کے جدول پڑھے یا لکھے نہیں جا سکے"

#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Fabric ٹیمپلیٹس انسٹال نہیں ہیں۔ انہیں صحت کے صفحے سے دوبارہ انسٹال کریں۔"

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "نوڈ پہلے ہی کسی ڈیوائس سے میپ کیا جا چکا ہے۔"

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "نوڈ کے فیبرک کو مین پولر سوئپ نہیں کرتا، اس لیے اس کی ڈیوائس کی پولنگ نہیں ہو سکی۔"

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "ڈیوائس موجود نہیں ہے۔"

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "ڈیوائس کی پولنگ اس پولر کے بجائے کسی دوسرے پولر سے ہو رہی ہے جو اس فیبرک کو سوئپ کرتا ہے، اس لیے یہ فیبرک کیش نہیں پڑھ سکی۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "ایک ڈیوائس \"%s\" (%s ڈیوائس ٹیمپلیٹ سے)، ہوسٹ نام %s، جسے پولر %d پول کرتا ہے، دستیابی کی جانچ اور SNMP بند ہونے کے ساتھ۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "اس پر %s ڈیٹا کوئیری، جو نوڈ کی پورٹس کی فہرست بناتی ہے۔ یہ خود سے کوئی گراف یا ڈیٹا ذریعہ نہیں بناتی۔"

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "نوڈ %s کے لیے Fabric پلگ ان نے بنایا۔ اس کی قدریں پلگ ان کیش سے آتی ہیں؛ ہوسٹ نام ایک مخصوص نام ہے جس سے کبھی رابطہ نہیں کیا جاتا۔"

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "نام: 1 سے 64 حروف، ہندسے، خالی جگہیں، نقطے، ڈیش، یا انڈراسکور استعمال کریں، جو کسی حرف یا ہندسے سے شروع ہوں۔"

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "بیک اینڈ: فہرست میں دیے گئے بیک اینڈز میں سے ایک منتخب کریں۔"

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "پولر: فہرست میں دیے گئے پولرز میں سے ایک منتخب کریں۔"

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "پولر: ریموٹ پولر سپورٹ شامل ہونے تک صرف مین پولر ہی فیبرک کو سوئپ کر سکتا ہے۔"

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "سوئپ وقفہ: %d سے %d تک مکمل سیکنڈ درج کریں۔"

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "ایڈاپٹر: مقامی ایڈاپٹر کا نام بالکل ویسے ہی درج کریں جیسا کرنل اسے نام دیتا ہے، جیسے mlx5_0۔"

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "ایڈاپٹر پورٹ: مقامی ایڈاپٹر کا پورٹ نمبر درج کریں، 1 سے %d تک۔"

