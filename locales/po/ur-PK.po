msgid "Optional absolute path to an infiniband-diags node name map file. Names it supplies are shown only; identity is always the node GUID."
msgstr "infiniband-diags نوڈ نام کی نقشہ فائل کا اختیاری مکمل راستہ۔ اس سے فراہم کردہ نام صرف دکھائے جاتے ہیں؛ شناخت ہمیشہ نوڈ GUID ہی ہوتی ہے۔"

#: lib/Settings.php
msgid "Datagram Timeout"
msgstr "ڈیٹا گرام ٹائم آؤٹ"

#: lib/Settings.php
msgid "Milliseconds each management datagram may take before the tools retry it (their -t option)."
msgstr "وہ ملی سیکنڈز جو ہر مینجمنٹ ڈیٹا گرام کو ٹولز کی جانب سے دوبارہ کوشش کرنے سے پہلے لگ سکتے ہیں (ان کا -t آپشن)۔"

#: lib/Settings.php
msgid "Command Timeout"
msgstr "کمانڈ ٹائم آؤٹ"

#: lib/Settings.php
msgid "Seconds one tool run may take before it is stopped and recorded as failed."
msgstr "وہ سیکنڈز جو ایک ٹول کے چلنے میں لگ سکتے ہیں اس سے پہلے کہ اسے روک کر ناکام ریکارڈ کیا جائے۔"

#: lib/Settings.php
msgid "KiB one tool run may print. Larger output is discarded and recorded as failed."
msgstr "KiB جو ایک ٹول رن پرنٹ کر سکتا ہے۔ اس سے بڑا آؤٹ پٹ مسترد کر کے ناکام ریکارڈ کیا جاتا ہے۔"

#: lib/Settings.php
msgid "Maximum Output"
msgstr "زیادہ سے زیادہ آؤٹ پٹ"

#: lib/Settings.php
msgid "Sweep"
msgstr "سویپ"

#: lib/Settings.php
msgid "Node Time Budget"
msgstr "نوڈ وقت کا بجٹ"

#: lib/Settings.php
msgid "Seconds one node sweep may spend reading counters. Ports not reached are read in the next cycle."
msgstr "وہ سیکنڈز جو ایک نوڈ سویپ کاؤنٹرز پڑھنے پر صرف کر سکتا ہے۔ جن پورٹس تک رسائی نہ ہو سکے انہیں اگلے سائیکل میں پڑھا جاتا ہے۔"

#: lib/Settings.php
msgid "Failed ports after which a node sweep stops for this cycle. A port that does not answer costs several seconds."
msgstr "وہ ناکام پورٹس کی تعداد جن کے بعد اس سائیکل کے لیے نوڈ سویپ رک جاتا ہے۔ جواب نہ دینے والا پورٹ کئی سیکنڈز صرف کرتا ہے۔"

#: lib/Settings.php
msgid "Node Failure Budget"
msgstr "نوڈ ناکامی کا بجٹ"

#: lib/Settings.php
msgid "Index Down Ports"
msgstr "ڈاؤن پورٹس کو انڈیکس کریں"

#: lib/Settings.php
msgid "When checked, the Fabric Port data query also lists ports that are down and have no remote end, such as unused adapter ports. Cleared, they are left out until they come up."
msgstr "جب نشان زد ہو، تو فیبرک پورٹ ڈیٹا کوئری ان پورٹس کو بھی فہرست میں شامل کرتی ہے جو ڈاؤن ہیں اور جن کا کوئی ریموٹ سرا نہیں ہے، جیسے غیر استعمال شدہ ایڈاپٹر پورٹس۔ نشان ہٹانے پر، انہیں اپ ہونے تک چھوڑ دیا جاتا ہے۔"

#: lib/Settings.php
msgid "Uninstall"
msgstr "ان انسٹال کریں"

#: lib/Settings.php
msgid "Keep Plugin Tables on Uninstall"
msgstr "ان انسٹال پر پلگ ان ٹیبلز برقرار رکھیں"

#: lib/Settings.php
msgid "When checked, uninstalling the plugin keeps its fabrics, inventory, and samples. Clear it to have the uninstall drop them; export the inventory first from the Fabric Admin page. The fabric is never contacted either way."
msgstr "جب نشان زد ہو، تو پلگ ان کو ان انسٹال کرنے پر اس کے فیبرکس، انوینٹری، اور نمونے محفوظ رہتے ہیں۔ ان انسٹال کے وقت انہیں حذف کرنے کے لیے نشان ہٹا دیں؛ پہلے فیبرک ایڈمن صفحے سے انوینٹری ایکسپورٹ کر لیں۔ کسی بھی صورت میں فیبرک سے رابطہ نہیں کیا جاتا۔"

#: lib/ToolDirectory.php
msgid "The tool directory must be an absolute path of letters, digits, dots, dashes, underscores, and slashes, with no trailing slash."
msgstr "ٹول ڈائریکٹری حروف، اعداد، نقاط، ڈیش، انڈراسکور اور سلیش پر مشتمل ایک مکمل راستہ ہونا چاہیے، جس کے آخر میں سلیش نہ ہو۔"

#: lib/ToolDirectory.php
msgid "The tool directory does not exist or is not a directory."
msgstr "ٹول ڈائریکٹری موجود نہیں ہے یا یہ کوئی ڈائریکٹری نہیں ہے۔"

#: lib/ToolDirectory.php
msgid "The tool directory path contains a symbolic link. Enter the real path."
msgstr "ٹول ڈائریکٹری کے راستے میں سمبولک لنک شامل ہے۔ اصل راستہ درج کریں۔"

#: lib/ToolDirectory.php
msgid "The tool directory is not owned by root."
msgstr "ٹول ڈائریکٹری root کی ملکیت میں نہیں ہے۔"

#: lib/ToolDirectory.php
msgid "The tool directory can be written by its group or by others."
msgstr "ٹول ڈائریکٹری میں اس کے گروپ یا دیگر صارفین کی جانب سے ترمیم کی جا سکتی ہے۔"

#: lib/ToolDirectory.php
msgid "A diagnostics tool is not owned by root."
msgstr "ایک تشخیصی ٹول root کی ملکیت میں نہیں ہے۔"

#: lib/ToolDirectory.php
msgid "A diagnostics tool can be written by its group or by others."
msgstr "ایک تشخیصی ٹول میں اس کے گروپ یا دیگر صارفین کی جانب سے ترمیم کی جا سکتی ہے۔"

#: setup.php
#, php-format
msgid "The Fabric plugin requires PHP %s or later. This server runs PHP %s, so the plugin was not installed or enabled."
msgstr "Fabric پلگ ان کے لیے PHP %s یا اس سے جدید ورژن درکار ہے۔ اس سرور پر PHP %s چل رہا ہے، اس لیے پلگ ان انسٹال یا فعال نہیں کیا گیا۔"

#: setup.php
