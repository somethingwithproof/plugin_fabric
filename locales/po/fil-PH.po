#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabric %s: hindi mabasa ang talaan ng kalusugan nito, kaya hindi alam ang estado ng pagtuklas nito. Tingnan ang Cacti log."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: hindi pa ito natutuklasan. Nagsisimula lamang ang mga pag-sweep mula sa isang node na nakamapa sa isang Cacti device, kaya patakbuhin nang isang beses ang \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" sa main poller."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: walang node na nakamapa sa isang Cacti device, kaya walang pag-sweep na nagsisimula at hindi nire-refresh ang imbentaryo. Magmapa ng node sa pahina ng Admin ng Fabric, o patakbuhin ang \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" sa main poller."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabric %s: %d na linya ng iblinkinfo ang hindi mabasa, malamang dahil ginagaya ng isang paglalarawan ng node ang output ng tool. Pinapanatili ng mga node na iyon ang kanilang huling mga estado ng link."

