msgstr "Poller: pumili ng isa sa mga nakalistang poller."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: ang main poller lamang ang maaaring mag-sweep ng isang fabric hanggang sa maidagdag ang suporta para sa remote poller."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Sweep Interval: maglagay ng buong segundo mula %d hanggang %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adapter: ilagay ang pangalan ng lokal na adapter ayon sa pagpapangalan ng kernel dito, gaya ng mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Adapter Port: ilagay ang numero ng port ng lokal na adapter, mula 1 hanggang %d."

