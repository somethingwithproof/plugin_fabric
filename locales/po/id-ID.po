#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "Fabric %s: ditetapkan ke poller %d, tetapi hanya poller utama yang dapat memindai fabric hingga dukungan poller jarak jauh ditambahkan. Fabric tidak dipindai; tetapkan ke poller utama."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabric %s: data kesehatannya tidak dapat dibaca, sehingga status penemuannya tidak diketahui. Lihat log Cacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: belum ditemukan. Pemindaian hanya dimulai dari node yang dipetakan ke perangkat Cacti, jadi jalankan \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" pada poller utama satu kali."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: tidak ada node yang dipetakan ke perangkat Cacti, sehingga pemindaian tidak dimulai dan inventaris tidak disegarkan. Petakan node di halaman Admin Fabric, atau jalankan \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" pada poller utama."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabric %s: %d baris iblinkinfo tidak dapat dibaca, kemungkinan besar karena deskripsi node menyerupai keluaran alat. Node tersebut mempertahankan status tautan terakhirnya."

