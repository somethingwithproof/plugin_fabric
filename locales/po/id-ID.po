#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "Node berubah setelah halaman dimuat, sehingga tidak ada tindakan yang dilakukan. Tinjau kembali dan coba lagi."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Izin perangkat Anda tidak mengizinkan perubahan pada data ini."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Nama: fabric lain sudah menggunakan nama ini."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Adaptor: fabric lain sudah memindai port adaptor ini pada poller ini. Satu fabric per port adaptor."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Fabric tidak dapat disimpan."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "Fabric berhasil disimpan."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Pemindaian fabric ini sedang berjalan, sehingga tidak ada yang dihapus. Coba lagi setelah selesai."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "Fabric beserta inventarisnya telah dihapus. Tidak ada perangkat Cacti yang diubah dan fabric tidak dihubungi."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Fabric tidak dapat dihapus."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "Identitas node tidak diubah."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Identitas node telah diperbarui. Pemindaian akan dilakukan lagi mulai siklus berikutnya."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Pemetaan perangkat dipindahkan ke node baru."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Usulan tidak dapat dikonfirmasi. Node mungkin telah berubah sejak usulan dibuat."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Usulan tidak dapat ditolak."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "Usulan telah ditolak."

