#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Templat Fabric belum dipasang. Pasang ulang dari halaman kesehatan."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Node sudah dipetakan ke suatu perangkat."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Fabric milik node ini tidak dipindai oleh poller utama, sehingga perangkatnya tidak dapat di-poll."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Perangkat tidak ada."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Perangkat di-poll oleh poller yang berbeda dari poller yang memindai fabric ini, sehingga tidak dapat membaca cache fabric."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Perangkat \"%s\" dari templat perangkat %s, nama host %s, di-poll oleh poller %d, dengan pemeriksaan ketersediaan dan SNMP nonaktif."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Kueri data %s di dalamnya, yang mencantumkan port node. Kueri ini tidak membuat grafik maupun sumber data secara otomatis."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Dibuat oleh plugin Fabric untuk node %s. Nilainya berasal dari cache plugin; nama host adalah nama khusus yang tidak pernah dihubungi."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Nama: gunakan 1 hingga 64 huruf, angka, spasi, titik, tanda hubung, atau garis bawah, dimulai dengan huruf atau angka."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Backend: pilih salah satu backend yang tercantum."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: pilih salah satu poller yang tercantum."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: hanya poller utama yang dapat memindai fabric hingga dukungan poller jarak jauh ditambahkan."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Interval Pemindaian: masukkan bilangan bulat detik dari %d hingga %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adaptor: masukkan nama adaptor lokal sesuai penamaan kernel, seperti mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Port Adaptor: masukkan nomor port adaptor lokal, dari 1 hingga %d."

