msgstr "Pemetaan node telah disimpan."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "Tidak ada perangkat yang dibuat. Lihat log Cacti."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "Perangkat telah dibuat dan node dipetakan ke perangkat tersebut. Pilih port yang akan dibuat grafiknya pada halaman New Graphs."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "Inventaris tidak dapat dibaca untuk diekspor."

