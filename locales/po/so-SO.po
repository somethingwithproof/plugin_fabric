#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: lama helin. Baaritaannadu waxay ka bilowdaan oo kaliya noodh ku xiran qalabka Cacti, sidaas darteed hal mar ku socodsii \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" main poller-ka."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: wax noodh ah kuma xirna qalabka Cacti, sidaas darteed wax baaritaan ah ma bilaabmo liiska agabkana lama cusboonaysiiyo. Ku xir noodh bogga Maamulka Fabric, ama ku socodsii \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" main poller-ka."

#: lib/HealthPage.php
