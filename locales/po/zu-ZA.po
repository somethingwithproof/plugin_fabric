#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "I-node ishintshile ngemva kokuba ikhasi lidwetshiwe, ngakho akukho okwenziwe. Lihlolisise bese uzama futhi."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Izimvume zakho zedivayisi azikuvumeli ukushintsha leli rekhodi."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Igama: enye i-fabric isivele isebenzisa leli gama."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "I-Adapter: enye i-fabric isivele iskena le port ye-adapter kule poller. I-fabric eyodwa nge-port ye-adapter ngayinye."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "I-fabric ayikwazanga ukulondolozwa."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "I-fabric ilondoloziwe."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Ukuskena kwale fabric kuyasebenza, ngakho akukho okusuliwe. Zama futhi uma kuqeda."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "I-fabric kanye ne-inventory yayo kusuliwe. Ayikho idivayisi ye-Cacti eshintshiwe futhi i-fabric ayithintwanga."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "I-fabric ayikwazanga ukusulwa."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "Umazisi we-node awushintshwanga."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Umazisi we-node uvuselelwe. Izoskenwa futhi kusukela emjikelezweni olandelayo."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Ukuhlotshaniswa kwedivayisi kuyiswe ku-node entsha."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Isiphakamiso asikwazanga ukuqinisekiswa. Kungenzeka ama-node ashintshile selokhu senziwa."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Isiphakamiso asikwazanga ukwenqatshwa."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "Isiphakamiso senqatshiwe."

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "Ukuhlotshaniswa kwe-node akushintshwanga. %s"

#: fabric_admin.php
msgid "The node mapping was not changed."
msgstr "Ukuhlotshaniswa kwe-node akushintshwanga."

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "Ukuhlotshaniswa kwe-node kulondoloziwe."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "Ayikho idivayisi edaliwe. Bheka ilogi ye-Cacti."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "Idivayisi idaliwe futhi i-node yahlotshaniswa nayo. Khetha ama-port ozowenza igrafu ekhasini elithi New Graphs."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "I-inventory ayikwazanga ukufundwa ukuze ithunyelwe ngaphandle."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "Amathempulethi e-Fabric nefayela lombuzo wedatha kufakiwe."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "Amathempulethi e-Fabric awafakwanga. Bheka ithebula le-Cacti Objects nelogi ye-Cacti."

