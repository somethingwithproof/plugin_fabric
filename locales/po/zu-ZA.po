#, php-format
msgid "Fabric %s: the inventory is %s; the last successful discovery was %s."
msgstr "I-Fabric %s: i-inventory ithi %s; ukutholwa kokugcina okuphumelele bekungo-%s."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "I-Fabric %s: yabelwe i-poller %d, kodwa yi-poller enkulu kuphela engaskena i-fabric kuze kube yilapho kwengezwa ukusekelwa kwe-poller ekude. Ayiskenwa; yabele i-poller enkulu."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "I-Fabric %s: irekhodi layo lempilo alikwazanga ukufundwa, ngakho isimo sayo sokutholwa asaziwa. Bheka ilogi ye-Cacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "I-Fabric %s: ayikatholwa. Ukuskena kuqala kuphela ku-node ehlotshaniswe nedivayisi ye-Cacti, ngakho sebenzisa \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" ku-poller enkulu kanye."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "I-Fabric %s: ayikho i-node ehlotshaniswe nedivayisi ye-Cacti, ngakho akukho ukuskena okuqalayo futhi i-inventory ayivuselelwa. Hlobanisa i-node ekhasini le-Fabric Admin, noma sebenzisa \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" ku-poller enkulu."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "I-Fabric %s: imigqa ye-iblinkinfo engu-%d ayikwazanga ukufundwa, okungenzeka ngoba incazelo ye-node ilingisa umphumela wethuluzi. Lawo ma-node agcina izimo zawo zokugcina zesixhumanisi."

