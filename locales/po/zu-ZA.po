#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Amathempulethi e-Fabric awafakiwe. Wafake kabusha kusukela ekhasini lempilo."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "I-node isivele ihlotshaniswe nedivayisi."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "I-fabric ye-node ayiskenwa yi-poller enkulu, ngakho idivayisi yayo ayikwazanga ukuhlolwa."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Idivayisi ayikho."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Idivayisi ihlolwa ngenye i-poller kunalena eskena le fabric, ngakho ayikwazanga ukufunda i-cache ye-fabric."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Idivayisi ethi \"%s\" evela kuthempulethi yedivayisi ethi %s, igama lomsingathi elithi %s, ehlolwa yi-poller %d, lapho ukuhlola ukutholakala ne-SNMP kuvaliwe."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Umbuzo wedatha othi %s kuyo, ohlela ama-port e-node. Awudali grafu futhi awudali mthombo wedatha ngokwawo."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Idalwe yi-plugin ye-Fabric ye-node ethi %s. Amanani ayo avela ku-cache ye-plugin; igama lomsingathi yigama eligodliwe elingathintwa nakanye."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Igama: sebenzisa izinhlamvu ezi-1 kuya kwezingama-64, izinombolo, izikhala, amachashazi, odwi, noma ama-underscore, uqale ngohlamvu noma ngenombolo."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "I-Backend: khetha enye yama-backend ahleliwe."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "I-Poller: khetha enye yama-poller ahleliwe."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "I-Poller: yi-poller enkulu kuphela engaskena i-fabric kuze kube yilapho kwengezwa ukusekelwa kwe-poller ekude."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Isikhawu Sokuskena: faka amasekhondi aphelele kusuka ku-%d kuya ku-%d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "I-Adapter: faka igama le-adapter yendawo njengoba i-kernel ilibiza ngalo, njenge-mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "I-Port ye-Adapter: faka inombolo ye-port ye-adapter yendawo, kusuka ku-1 kuya ku-%d."

