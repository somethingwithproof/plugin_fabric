#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it is assigned to poller %d, but only the main poller can sweep a fabric until remote poller support is added. It is not swept; assign it to the main poller."
msgstr "Ifabric %s: inikezelwe kwipoller %d, kodwa yipoller ephambili kuphela enokuhlola ifabric de kongezwe inkxaso yepoller ekude. Ayihlolwa; yinikezele kwipoller ephambili."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Ifabric %s: irekhodi yayo yempilo ayikwazanga ukufundwa, ngoko ke imeko yayo yofumano ayaziwa. Jonga ilogi yeCacti."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Ifabric %s: ayikafunyanwa. Uhlolo luqala kuphela kwinode enxulunyaniswe nesixhobo seCacti, ngoko ke sebenzisa \\\"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\\\" kwipoller ephambili kanye."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Ifabric %s: akukho node enxulunyaniswe nesixhobo seCacti, ngoko ke akukho hlolo luqalayo kwaye uluhlu aluhlaziywa. Nxulumanisa inode kwiphepha loLawulo lweFabric, okanye sebenzisa \\\"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\\\" kwipoller ephambili."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Ifabric %s: imigca ye-iblinkinfo eyi-%d ayikwazanga ukufundwa, kusenokwenzeka ukuba kungenxa yokuba inkcazelo yenode ilingisa imveliso yesixhobo. Ezo node zigcina iimeko zazo zokugqibela zoqhagamshelo."

