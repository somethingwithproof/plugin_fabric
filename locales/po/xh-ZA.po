#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Iitemplate zeFabric azifakwanga. Phinda uzifake ukusuka kwiphepha lempilo."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Inode sele inxulunyaniswe nesixhobo."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Ifabric yenode ayihlolwa yipoller ephambili, ngoko ke isixhobo sayo asikwazanga ukuvavanywa."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Isixhobo asikho."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Isixhobo sivavanywa yenye ipoller kunaleyo ihlola le fabric, ngoko ke asikwazanga ukufunda ikheshe yefabric."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Isixhobo \\\"%s\\\" esivela kwitemplate yesixhobo ye-%s, igama lehost %s, sivavanywa yipoller %d, ukuhlolwa kobukho kunye ne-SNMP zicinyiwe."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Umbuzo wedatha we-%s kuyo, odwelisa iiport zenode. Awenzi grafu okanye mthombo wedatha ngokwawo."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Yenziwe yiplagini ye-Fabric yenode %s. Amaxabiso ayo avela kwikheshe yeplagini; igama lehost ligama elibekelwe bucala elingaze liqhagamshelwe."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Igama: sebenzisa oonobumba, amanani, izithuba, amachaphaza, imigca edibanisayo, okanye i-underscore eziyi-1 ukuya ku-64, uqale ngonobumba okanye inani."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Ibackend: khetha enye yeebackend ezidwelisiweyo."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Ipoller: khetha enye yeepoller ezidwelisiweyo."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Ipoller: yipoller ephambili kuphela enokuhlola ifabric de kongezwe inkxaso yepoller ekude."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Ixesha loHlolo: faka imizuzwana epheleleyo ukusuka ku-%d ukuya ku-%d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Iadapter: faka igama leadapter yendawo njengoko i-kernel ilibiza ngalo, njenge-mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Iport yeAdapter: faka inombolo yeport yeadapter yendawo, ukusuka ku-1 ukuya ku-%d."

