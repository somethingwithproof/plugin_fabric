#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "Inode itshintshile emva kokuba iphepha lizotywe, ngoko ke akukho nto yenziweyo. Yihlole uze uzame kwakhona."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Iimvume zakho zesixhobo azikuvumeli ukutshintsha le rekhodi."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Igama: enye ifabric sele isebenzisa eli gama."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Iadapter: enye ifabric sele ihlola le port yeadapter kule poller. Ifabric enye ngeport nganye yeadapter."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Ifabric ayikwazanga ukugcinwa."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "Ifabric igciniwe."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Uhlolo lwale fabric luyaqhubeka, ngoko ke akukho nto icinyiweyo. Zama kwakhona xa lugqibile."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "Ifabric kunye noluhlu lwayo zicinyiwe. Akukho sixhobo seCacti sitshintshiweyo kwaye akukho nxibelelwano lwenziweyo nefabric."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Ifabric ayikwazanga ukucinywa."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "Ubuni benode abutshintshwanga."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Ubuni benode buhlaziyiwe. Buya kuphinda buhlolwe ukususela kumjikelo olandelayo."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Unxulumaniso lwesixhobo luhanjiselwe kwinode entsha."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Isiphakamiso asikwazanga ukuqinisekiswa. Iinode kusenokwenzeka ukuba zitshintshile ukususela oko senziwayo."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Isiphakamiso asikwazanga ukwaliwa."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "Isiphakamiso siliwe."

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "Unxulumaniso lwenode alutshintshwanga. %s"

#: fabric_admin.php
