msgstr "Unxulumaniso lwenode lugciniwe."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "Akukho sixhobo senziweyo. Jonga ilogi yeCacti."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "Isixhobo senziwe kwaye inode yanxulunyaniswa naso. Khetha iiport zokuzoba kwigrafu kwiphepha leeGrafu eziNtsha."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "Uluhlu alukwazanga ukufundwa ukuze luthunyelwe ngaphandle."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "Iitemplate zeFabric kunye nefayile yombuzo wedatha zifakiwe."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "Iitemplate zeFabric azifakwanga. Jonga itheyibhile yeZinto zeCacti kunye nelogi yeCacti."

