#: lib/CommandError.php
msgid "The fabric or plugin settings are incomplete or invalid"
msgstr "Настройките на комутационната мрежа или плъгина са непълни или невалидни"

#: lib/CommandError.php
msgid "The tool is missing or not executable in the configured directory"
msgstr "Инструментът липсва или не е изпълним в конфигурираната директория"

#: lib/CommandError.php
msgid "The tool exceeded its time limit and was stopped"
msgstr "Инструментът надвиши времевото си ограничение и беше спрян"

#: lib/CommandError.php
msgid "The tool output exceeded the size limit and was discarded"
msgstr "Изходът на инструмента надвиши ограничението за размер и беше отхвърлен"

#: lib/CommandError.php
msgid "The tool failed"
msgstr "Инструментът завърши с грешка"

#: lib/CommandError.php
msgid "The tool output did not have the expected form"
msgstr "Изходът на инструмента не беше в очаквания формат"

#: lib/CommandError.php
msgid "Not attempted: the time or failure budget was spent"
msgstr "Не е опитано: бюджетът за време или неуспехи е изчерпан"

#: lib/CommandError.php
msgid "The plugin tables could not be read or written"
msgstr "Таблиците на плъгина не можаха да бъдат прочетени или записани"

#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Шаблоните на Fabric не са инсталирани. Преинсталирайте ги от страницата за състоянието."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Възелът вече е свързан с устройство."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Комутационната мрежа на възела не се обхожда от главния полър, така че устройството му не може да бъде анкетирано."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Устройството не съществува."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Устройството се анкетира от различен полър от този, който обхожда тази комутационна мрежа, така че не може да прочете кеша ѝ."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Устройство „%s“ от шаблона за устройство %s, име на хост %s, анкетирано от полър %d, с изключени проверки за достъпност и SNMP."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Заявката за данни %s върху него, изброяваща портовете на възела. Сама по себе си тя не създава графика или източник на данни."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Създадено от плъгина Fabric за възел %s. Стойностите му идват от кеша на плъгина; името на хоста е запазено име, с което никога не се осъществява връзка."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Име: използвайте от 1 до 64 букви, цифри, интервали, точки, тирета или долни черти, започващи с буква или цифра."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Бекенд: изберете един от посочените бекенди."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Полър: изберете един от посочените полъри."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Полър: само главният полър може да обхожда комутационна мрежа, докато не бъде добавена поддръжка за отдалечени полъри."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Интервал на обхождане: въведете цял брой секунди от %d до %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Адаптер: въведете локалното име на адаптера, както ядрото го именува, например mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Порт на адаптера: въведете номера на порта на локалния адаптер от 1 до %d."

