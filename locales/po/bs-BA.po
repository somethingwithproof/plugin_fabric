#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Mrežna struktura %s: njen zapis o zdravlju nije mogao biti pročitan, pa je stanje otkrivanja nepoznato. Pogledajte Cacti zapisnik."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Mrežna struktura %s: još nije otkrivena. Skeniranja počinju samo od čvora mapiranog na Cacti uređaj, pa pokrenite jednom komandu \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" na glavnom polleru."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Mrežna struktura %s: nijedan čvor nije mapiran na Cacti uređaj, pa se skeniranje ne pokreće i inventar se ne osvježava. Mapirajte čvor na stranici Fabric administracija ili pokrenite komandu \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" na glavnom polleru."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Mrežna struktura %s: nije bilo moguće pročitati %d linija iz iblinkinfo, najvjerovatnije zato što opis čvora oponaša izlaz alata. Ti čvorovi zadržavaju svoja posljednja stanja linka."

