#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Šabloni Fabric nisu instalirani. Ponovo ih instalirajte sa stranice zdravlja."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Čvor je već mapiran na uređaj."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Mrežnu strukturu ovog čvora ne skenira glavni poller, pa njegov uređaj ne može biti anketiran."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Uređaj ne postoji."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Uređaj anketira drugi poller, različit od onog koji skenira ovu mrežnu strukturu, pa ne može pročitati keš mrežne strukture."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Uređaj \"%s\" iz šablona uređaja %s, naziv računara %s, anketiran preko pollera %d, sa isključenim provjerama dostupnosti i SNMP-om."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Upit podataka %s na njemu, koji daje spisak portova čvora. Sam po sebi ne kreira grafikon niti izvor podataka."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Kreirao dodatak Fabric za čvor %s. Njegove vrijednosti dolaze iz keša dodatka; naziv računara je rezervisano ime koje se nikada ne kontaktira."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Naziv: koristite od 1 do 64 slova, cifre, razmake, tačke, crtice ili donje crte, počevši slovom ili cifrom."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Pozadinski sistem: odaberite jedan od navedenih pozadinskih sistema."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: odaberite jedan od navedenih pollera."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: samo glavni poller može skenirati mrežnu strukturu dok se ne doda podrška za udaljene pollere."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Interval skeniranja: unesite cijeli broj sekundi od %d do %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adapter: unesite naziv lokalnog adaptera onako kako ga imenuje kernel, na primjer mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Port adaptera: unesite broj porta lokalnog adaptera, od 1 do %d."

