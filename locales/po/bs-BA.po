#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "Čvor se promijenio nakon učitavanja stranice, pa ništa nije urađeno. Pregledajte podatke i pokušajte ponovo."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Vaše dozvole za uređaje ne dopuštaju izmjenu ovog zapisa."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Naziv: druga mrežna struktura već koristi ovaj naziv."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Adapter: druga mrežna struktura već skenira ovaj port adaptera na ovom polleru. Dozvoljena je jedna mrežna struktura po portu adaptera."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Mrežna struktura nije mogla biti sačuvana."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "Mrežna struktura je sačuvana."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Skeniranje ove mrežne strukture je u toku, pa ništa nije obrisano. Pokušajte ponovo kada završi."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "Mrežna struktura i njen inventar su obrisani. Nijedan Cacti uređaj nije izmijenjen niti je mrežna struktura kontaktirana."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Mrežna struktura nije mogla biti obrisana."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "Identitet čvora nije promijenjen."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Identitet čvora je ažuriran. Ponovo će se skenirati od sljedećeg ciklusa."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Mapiranje uređaja je prebačeno na novi čvor."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Prijedlog nije mogao biti potvrđen. Moguće je da su se čvorovi promijenili otkako je kreiran."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Prijedlog nije mogao biti odbijen."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "Prijedlog je odbijen."

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "Mapiranje čvora nije promijenjeno. %s"

#: fabric_admin.php
msgid "The node mapping was not changed."
msgstr "Mapiranje čvora nije promijenjeno."

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "Mapiranje čvora je sačuvano."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "Nijedan uređaj nije kreiran. Pogledajte Cacti zapisnik."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "Uređaj je kreiran i čvor je mapiran na njega. Odaberite portove za grafikone na stranici Novi grafikoni."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "Inventar nije mogao biti pročitan za izvoz."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "Šabloni Fabric i datoteka upita podataka su instalirani."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "Šabloni Fabric nisu instalirani. Pogledajte tabelu Cacti objekti i Cacti zapisnik."

