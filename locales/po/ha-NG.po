msgid "Poller: choose one of the listed pollers."
msgstr "Poller: zaɓi ɗaya daga cikin pollers da aka jera."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: main poller kaɗai zai iya share fabric har sai an ƙara goyon bayan poller na nesa."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Tazarar Sharewa: shigar da cikakkun daƙiƙoƙi daga %d zuwa %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adapter: shigar da sunan adapter na gida kamar yadda kernel ke kiransa, kamar mlx5_0."

