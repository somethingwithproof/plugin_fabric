msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "An sabunta shaidar node ɗin. Za a sake share shi daga zagaye na gaba."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Taswirar na'urar ta koma sabon node ɗin."

