#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "Node ya sauya bayan an zana shafin, don haka ba a yi komai ba. Duba shi sannan ka sake gwadawa."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Izinin na'urarka ba su yarda a sauya wannan bayanin ba."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Suna: wani fabric yana amfani da wannan sunan tuni."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Adapter: wani fabric yana share wannan tashar adapter a kan wannan poller tuni. Fabric ɗaya ne ga kowace tashar adapter."

