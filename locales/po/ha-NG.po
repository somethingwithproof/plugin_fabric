#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: ba a gano shi ba tukuna. Sharewa tana farawa ne kawai daga node da aka taswira zuwa na'urar Cacti, don haka gudanar da \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" a kan main poller sau ɗaya."

#: lib/HealthPage.php
#, php-format
