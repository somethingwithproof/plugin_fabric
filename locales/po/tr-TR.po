#: lib/PrivilegeProbe.php lib/ToolDirectory.php
msgid "A diagnostics tool has the setuid or setgid bit. The plugin never needs it."
msgstr "Bir tanılama aracında setuid veya setgid biti var. Eklentinin buna hiçbir zaman ihtiyacı yoktur."

#: lib/PrivilegeProbe.php
msgid "A diagnostics tool or its directory can be written by an account other than its owner, or by the poller account. Whoever can write it chooses what the poller runs."
msgstr "Bir tanılama aracı veya dizini, sahibi dışındaki bir hesap ya da yoklayıcı hesabı tarafından yazılabilir durumda. Oraya yazabilen kişi, yoklayıcının ne çalıştıracağını belirleyebilir."

#: lib/PrivilegeProbe.php
msgid "A umad device is readable or writable by every account, so any local user can query the fabric. Restrict it to a group."
msgstr "Bir umad cihazı her hesap tarafından okunabilir veya yazılabilir durumda; dolayısıyla herhangi bir yerel kullanıcı fabric yapısını sorgulayabilir. Erişimi bir grupla kısıtlayın."

#: lib/PrivilegeProbe.php lib/ToolDirectory.php
