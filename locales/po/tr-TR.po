#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: henüz keşfedilmedi. Taramalar yalnızca bir Cacti cihazına eşlenmiş bir düğümden başlar; bu nedenle ana yoklayıcıda bir kez \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" komutunu çalıştırın."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: hiçbir düğüm bir Cacti cihazına eşlenmemiş, bu nedenle tarama başlamaz ve envanter yenilenmez. Fabric Yönetimi sayfasında bir düğüm eşleyin veya ana yoklayıcıda \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" komutunu çalıştırın."

#: lib/HealthPage.php
