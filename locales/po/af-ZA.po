#, php-format
msgid "Fabric %s: its health record could not be read, so its discovery state is unknown. See the Cacti log."
msgstr "Fabric %s: sy gesondheidsrekord kon nie gelees word nie, so sy ontdekkingstatus is onbekend. Sien die Cacti-logboek."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: it has not been discovered. Sweeps start only from a node mapped to a Cacti device, so run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller once."
msgstr "Fabric %s: dit is nog nie ontdek nie. Skanderings begin slegs vanaf 'n nodus wat aan 'n Cacti-toestel gekarteer is, so voer \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" een keer op die hoof-poller uit."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: no node is mapped to a Cacti device, so no sweep starts and the inventory is not refreshed. Map a node on the Fabric Admin page, or run \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" on the main poller."
msgstr "Fabric %s: geen nodus is aan 'n Cacti-toestel gekarteer nie, so geen skandering begin nie en die inventaris word nie verfris nie. Karteer 'n nodus op die Fabric-administrasiebladsy, of voer \"php %s/plugins/fabric/fabric_sweep.php --fabric=%d --force\" op die hoof-poller uit."

#: lib/HealthPage.php
#, php-format
msgid "Fabric %s: %d iblinkinfo lines could not be read, most likely because a node description imitates the tool output. Those nodes keep their last link states."
msgstr "Fabric %s: %d iblinkinfo-reëls kon nie gelees word nie, heel waarskynlik omdat 'n nodusbeskrywing die nutsding-afvoer naboots. Daardie nodusse behou hul laaste skakelstate."

