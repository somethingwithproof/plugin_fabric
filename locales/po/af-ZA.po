msgid "Backend: choose one of the listed backends."
msgstr "Agterend: kies een van die gelyste agterende."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: kies een van die gelyste pollers."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: slegs die hoof-poller kan 'n fabric skandeer totdat ondersteuning vir afgeleë pollers bygevoeg word."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Skanderingsinterval: voer heel sekondes van %d tot %d in."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adapter: voer die plaaslike adapternaam in soos die kern dit noem, soos mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Adapterpoort: voer die poortnommer van die plaaslike adapter in, van 1 tot %d."

