#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "Чвор се променио након исцртавања странице, па ништа није урађено. Прегледајте га и покушајте поново."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "Ваше дозволе за уређаје не допуштају измену овог записа."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Назив: друга мрежна структура већ користи овај назив."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Адаптер: друга мрежна структура већ скенира овај порт адаптера на овом полеру. Дозвољена је једна мрежна структура по порту адаптера."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Мрежна структура није могла да се сачува."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "Мрежна структура је сачувана."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Скенирање ове мрежне структуре је у току, па ништа није обрисано. Покушајте поново када се заврши."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "Мрежна структура и њен инвентар су обрисани. Ниједан Cacti уређај није измењен и мрежна структура није контактирана."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Мрежна структура није могла да се обрише."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "Идентитет чвора није промењен."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "Идентитет чвора је ажуриран. Поново се скенира од следећег циклуса."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "Мапирање уређаја је премештено на нови чвор."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Предлог није могао да се потврди. Чворови су се можда променили откако је направљен."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Предлог није могао да се одбије."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "Предлог је одбијен."

#: fabric_admin.php
#, php-format
msgid "The node mapping was not changed. %s"
msgstr "Мапирање чвора није промењено. %s"

#: fabric_admin.php
msgid "The node mapping was not changed."
msgstr "Мапирање чвора није промењено."

#: fabric_admin.php
msgid "The node mapping was saved."
msgstr "Мапирање чвора је сачувано."

#: fabric_admin.php
msgid "No device was created. See the Cacti log."
msgstr "Ниједан уређај није креиран. Погледајте Cacti дневник."

#: fabric_admin.php
msgid "The device was created and the node mapped to it. Choose the ports to graph on the New Graphs page."
msgstr "Уређај је креиран и чвор је мапиран на њега. Изаберите портове за графиконе на страници Нови графикони."

#: fabric_admin.php
msgid "The inventory could not be read for export."
msgstr "Инвентар није могао да се прочита за извоз."

#: fabric_health.php
msgid "The Fabric templates and data query file were installed."
msgstr "Шаблони Fabric и датотека упита података су инсталирани."

#: fabric_health.php
msgid "The Fabric templates were not installed. See the Cacti Objects table and the Cacti log."
msgstr "Шаблони Fabric нису инсталирани. Погледајте табелу Cacti објекти и Cacti дневник."

#: fabric_operator.php
msgid "Monitoring view"
msgstr "Приказ надзора"

#: fabric_operator.php
msgid "Observations could not be read. Ask an administrator to check the plugin log."
msgstr "Запажања нису могла да се прочитају. Замолите администратора да провери дневник додатка."

#: include/operator.php
msgid "Inspect port validity, link width and speed, and the congestion view. Escalate identity conflicts and device relinking to an administrator; do not reset counters."
msgstr "Проверите исправност портова, ширину и брзину везе, као и приказ загушења. Сукобе идентитета и поновно повезивање уређаја проследите администратору; немојте ресетовати бројаче."

