#: lib/CommandError.php
msgid "The fabric or plugin settings are incomplete or invalid"
msgstr "Подешавања мрежне структуре или додатка су непотпуна или неисправна"

#: lib/CommandError.php
msgid "The tool is missing or not executable in the configured directory"
msgstr "Алат недостаје или није извршан у конфигурисаном директоријуму"

#: lib/CommandError.php
msgid "The tool exceeded its time limit and was stopped"
msgstr "Алат је прекорачио временско ограничење и заустављен је"

#: lib/CommandError.php
msgid "The tool output exceeded the size limit and was discarded"
msgstr "Излаз алата је прекорачио ограничење величине и одбачен је"

#: lib/CommandError.php
msgid "The tool failed"
msgstr "Извршавање алата није успело"

#: lib/CommandError.php
msgid "The tool output did not have the expected form"
msgstr "Излаз алата није имао очекивани облик"

#: lib/CommandError.php
msgid "Not attempted: the time or failure budget was spent"
msgstr "Није покушано: временски буџет или буџет грешака је потрошен"

#: lib/CommandError.php
msgid "The plugin tables could not be read or written"
msgstr "Табеле додатка нису могле да се прочитају или упишу"

#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Шаблони Fabric нису инсталирани. Поново их инсталирајте са странице исправности."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Чвор је већ мапиран на уређај."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Мрежну структуру овог чвора не скенира главни полер, па његов уређај не може да се анкетира."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Уређај не постоји."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Уређај анкетира други полер, различит од оног који скенира ову мрежну структуру, па не може да прочита кеш мрежне структуре."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Уређај \"%s\" из шаблона уређаја %s, назив рачунара %s, анкетиран преко полера %d, са искљученим проверама доступности и SNMP-ом."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Упит података %s на њему, који приказује списак портова чвора. Сам по себи не креира графикон нити извор података."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Креирао додатак Fabric за чвор %s. Његове вредности долазе из кеша додатка; назив рачунара је резервисано име које се никада не контактира."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Назив: користите од 1 до 64 слова, цифре, размаке, тачке, цртице или доње црте, почевши словом или цифром."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Позадински систем: изаберите један са списка."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Полер: изаберите један са списка."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Полер: само главни полер може да скенира мрежну структуру док се не дода подршка за удаљене полере."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Интервал скенирања: унесите цео број секунди од %d до %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Адаптер: унесите назив локалног адаптера онако како га именује кернел, на пример mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Порт адаптера: унесите број порта локалног адаптера, од 1 до %d."

