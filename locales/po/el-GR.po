#: lib/DeviceProvisioner.php
msgid "The Fabric templates are not installed. Reinstall them from the health page."
msgstr "Τα πρότυπα Fabric δεν είναι εγκατεστημένα. Επανεγκαταστήστε τα από τη σελίδα υγείας."

#: lib/DeviceProvisioner.php
msgid "The node is already mapped to a device."
msgstr "Ο κόμβος είναι ήδη αντιστοιχισμένος σε μια συσκευή."

#: lib/DeviceProvisioner.php
msgid "The node's fabric is not swept by the main poller, so its device could not be polled."
msgstr "Το δίκτυο Fabric του κόμβου δεν σαρώνεται από τον κύριο poller, επομένως δεν ήταν δυνατή η συλλογή της συσκευής του."

#: lib/DeviceProvisioner.php
msgid "The device does not exist."
msgstr "Η συσκευή δεν υπάρχει."

#: lib/DeviceProvisioner.php
msgid "The device is polled by another poller than the one that sweeps this fabric, so it could not read the fabric cache."
msgstr "Η συσκευή συλλέγεται από διαφορετικό poller από αυτόν που σαρώνει το δίκτυο Fabric, επομένως δεν μπόρεσε να διαβάσει την προσωρινή μνήμη του δικτύου Fabric."

#: lib/DeviceProvisioner.php
#, php-format
msgid "A device \"%s\" from the %s device template, host name %s, polled by poller %d, with availability checks and SNMP off."
msgstr "Μια συσκευή «%s» από το πρότυπο συσκευής %s, όνομα κεντρικού υπολογιστή %s, που συλλέγεται από τον poller %d, με απενεργοποιημένους ελέγχους διαθεσιμότητας και SNMP."

#: lib/DeviceProvisioner.php
#, php-format
msgid "The %s data query on it, listing the node's ports. It creates no graph and no data source by itself."
msgstr "Το ερώτημα δεδομένων %s σε αυτήν, που παραθέτει τις θύρες του κόμβου. Δεν δημιουργεί κανένα γράφημα και καμία πηγή δεδομένων από μόνο του."

#: lib/DeviceProvisioner.php
#, php-format
msgid "Created by the Fabric plugin for node %s. Its values come from the plugin cache; the host name is a reserved name that is never contacted."
msgstr "Δημιουργήθηκε από το πρόσθετο Fabric για τον κόμβο %s. Οι τιμές της προέρχονται από την προσωρινή μνήμη του πρόσθετου· το όνομα κεντρικού υπολογιστή είναι δεσμευμένο όνομα με το οποίο δεν γίνεται ποτέ επικοινωνία."

#: lib/FabricInput.php
msgid "Name: use 1 to 64 letters, digits, spaces, dots, dashes, or underscores, starting with a letter or digit."
msgstr "Όνομα: χρησιμοποιήστε 1 έως 64 γράμματα, ψηφία, κενά, τελείες, παύλες ή κάτω παύλες, ξεκινώντας με γράμμα ή ψηφίο."

#: lib/FabricInput.php
msgid "Backend: choose one of the listed backends."
msgstr "Σύστημα υποστήριξης: επιλέξτε ένα από τα αναγραφόμενα συστήματα υποστήριξης."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: επιλέξτε έναν από τους αναγραφόμενους pollers."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: μόνο ο κύριος poller μπορεί να σαρώσει ένα δίκτυο Fabric έως ότου προστεθεί υποστήριξη απομακρυσμένων pollers."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Διάστημα σάρωσης: εισαγάγετε ακέραια δευτερόλεπτα από %d έως %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Προσαρμογέας: εισαγάγετε το όνομα του τοπικού προσαρμογέα όπως το ονομάζει ο πυρήνας, όπως mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Θύρα προσαρμογέα: εισαγάγετε τον αριθμό θύρας του τοπικού προσαρμογέα, από 1 έως %d."

