#: fabric_admin.php
msgid "The node changed after the page was drawn, so nothing was done. Review it and try again."
msgstr "O nó foi alterado depois de a página ter sido carregada, pelo que nada foi feito. Reveja-o e tente novamente."

#: fabric_admin.php
msgid "Your device permissions do not allow changing this record."
msgstr "As suas permissões de dispositivo não permitem alterar este registo."

#: fabric_admin.php
msgid "Name: another fabric already uses this name."
msgstr "Nome: outra malha já utiliza este nome."

#: fabric_admin.php
msgid "Adapter: another fabric already sweeps this adapter port on this poller. One fabric per adapter port."
msgstr "Adaptador: outra malha já varre esta porta de adaptador neste poller. Uma malha por porta de adaptador."

#: fabric_admin.php
msgid "The fabric could not be saved."
msgstr "Não foi possível guardar a malha."

#: fabric_admin.php
msgid "The fabric was saved."
msgstr "A malha foi guardada."

#: fabric_admin.php
msgid "A sweep of this fabric is running, so nothing was deleted. Try again when it finishes."
msgstr "Está a decorrer um varrimento desta malha, pelo que nada foi eliminado. Tente novamente quando terminar."

#: fabric_admin.php
msgid "The fabric and its inventory were deleted. No Cacti device was changed and the fabric was not contacted."
msgstr "A malha e o seu inventário foram eliminados. Nenhum dispositivo do Cacti foi alterado e a malha não foi contactada."

#: fabric_admin.php
msgid "The fabric could not be deleted."
msgstr "Não foi possível eliminar a malha."

#: fabric_admin.php
msgid "The node identity was not changed."
msgstr "A identidade do nó não foi alterada."

#: fabric_admin.php
msgid "The node identity was updated. It is swept again from the next cycle."
msgstr "A identidade do nó foi atualizada. Voltará a ser varrido a partir do ciclo seguinte."

#: fabric_admin.php
msgid "The device mapping moved to the new node."
msgstr "A associação do dispositivo foi movida para o novo nó."

#: fabric_admin.php
msgid "The proposal could not be confirmed. The nodes may have changed since it was made."
msgstr "Não foi possível confirmar a proposta. Os nós podem ter sido alterados desde que foi criada."

#: fabric_admin.php
msgid "The proposal could not be rejected."
msgstr "Não foi possível rejeitar a proposta."

#: fabric_admin.php
msgid "The proposal was rejected."
msgstr "A proposta foi rejeitada."

