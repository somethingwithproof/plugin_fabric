msgid "Backend: choose one of the listed backends."
msgstr "Backend: escolha um dos backends listados."

#: lib/FabricInput.php
msgid "Poller: choose one of the listed pollers."
msgstr "Poller: escolha um dos pollers listados."

#: lib/FabricInput.php
msgid "Poller: only the main poller can sweep a fabric until remote poller support is added."
msgstr "Poller: apenas o poller principal pode varrer uma malha até que seja adicionado suporte para pollers remotos."

#: lib/FabricInput.php
#, php-format
msgid "Sweep Interval: enter whole seconds from %d to %d."
msgstr "Intervalo de varrimento: introduza segundos inteiros de %d a %d."

#: lib/FabricInput.php
msgid "Adapter: enter the local adapter name as the kernel names it, such as mlx5_0."
msgstr "Adaptador: introduza o nome do adaptador local tal como o kernel o designa, por exemplo mlx5_0."

#: lib/FabricInput.php
#, php-format
msgid "Adapter Port: enter the port number of the local adapter, from 1 to %d."
msgstr "Porta do adaptador: introduza o número da porta do adaptador local, de 1 a %d."

